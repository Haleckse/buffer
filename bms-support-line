/**
 * Unified BMS Support Handler
 * 1. Guarantees atomic, permanent Ticket ID generation (BMS-XXXXX).
 * 2. Logs all ticket changes to the "Ticket History" tab.
 * 3. Sends automated email notifications on assignment or status change.
 * 
 * TRIGGERS TO SET in Apps Script Dashboard (Triggers -> Add Trigger):
 *  1. Function: handleSpreadsheetEdit  | Event: On edit (Installable Trigger)
 *  2. Function: handleFormSubmit       | Event: On form submit (if using Google Forms)
 */

// ==========================================
// 1. TICKET ID GENERATOR (ATOMIC & CONCURRENT-SAFE)
// ==========================================

/**
 * Returns existing Ticket ID or generates a permanent, sequential Ticket ID (e.g., BMS-00001).
 * Safe for concurrent company-wide usage via LockService.
 */
function getOrGenerateTicketId(sheet, row, ticketIdCol) {
  const currentVal = sheet.getRange(row, ticketIdCol).getValue();
  if (currentVal && String(currentVal).trim() !== "" && !String(currentVal).startsWith("Row ")) {
    return String(currentVal).trim();
  }

  // Obtain exclusive execution lock to prevent duplicate IDs during concurrent writes
  const lock = LockService.getScriptLock();
  try {
    lock.waitLock(15000); // Wait up to 15 seconds for previous execution
  } catch (e) {
    console.error("Lock timeout during Ticket ID generation: " + e.message);
    return `BMS-${Utilities.formatDate(new Date(), "GMT", "yyyyMMdd-HHmmss")}`;
  }

  try {
    const props = PropertiesService.getDocumentProperties();
    let lastNumber = Number(props.getProperty("LAST_TICKET_NUMBER"));

    // If counter is not set yet, discover the highest existing ticket number
    if (!lastNumber || isNaN(lastNumber)) {
      lastNumber = 0;
      const lastRow = sheet.getLastRow();
      if (lastRow > 1) {
        const idValues = sheet.getRange(2, ticketIdCol, lastRow - 1, 1).getValues();
        idValues.forEach(r => {
          const match = String(r[0]).match(/BMS-(\d+)/i);
          if (match) {
            const num = parseInt(match[1], 10);
            if (num > lastNumber) lastNumber = num;
          }
        });
      }
    }

    lastNumber += 1;
    props.setProperty("LAST_TICKET_NUMBER", lastNumber.toString());

    // 5-digit padding: BMS-00001 to BMS-99999
    const formattedId = "BMS-" + Utilities.formatString("%05d", lastNumber);

    // Stamp permanent raw text into the cell
    sheet.getRange(row, ticketIdCol).setValue(formattedId);
    SpreadsheetApp.flush(); // Commit write immediately

    return formattedId;
  } finally {
    lock.releaseLock();
  }
}

// ==========================================
// 2. FORM SUBMIT HANDLER (Trigger: On form submit)
// ==========================================

/**
 * Reads submission from 'Form Responses', generates an ID, and appends to 'Tickets'.
 */
function handleFormSubmit(e) {
  if (!e || !e.range) return;
  const sourceSheet = e.range.getSheet();

  // Verify submission came from the Form Responses tab
  if (!sourceSheet.getName().toLowerCase().includes("form response")) return;

  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const dbSheet = ss.getSheetByName("Tickets");
  if (!dbSheet) return;

  const formRow = e.range.getRow();
  const formHeaders = sourceSheet.getRange(1, 1, 1, sourceSheet.getLastColumn()).getValues()[0];
  const formValues = sourceSheet.getRange(formRow, 1, 1, formHeaders.length).getValues()[0];

  // Helper to extract fields from Form Responses
  const getFormVal = (colName) => {
    const idx = formHeaders.findIndex(h => String(h).trim().toLowerCase() === colName.toLowerCase());
    return (idx >= 0 && formValues[idx] !== undefined) ? formValues[idx] : "";
  };

  const timestamp    = getFormVal("Timestamp") || new Date();
  const email        = getFormVal("Email Address");
  const siglum       = getFormVal("Siglum");
  const summary      = getFormVal("Summary") || "(Untitled Request)";
  const description  = getFormVal("Description");
  const criticality  = getFormVal("Criticality") || "Medium";
  const urgency      = getFormVal("Urgency") || "Default";
  const requestType  = getFormVal("Request type") || "General";
  const attachFile   = getFormVal("Attach file");
  const status       = "To Do";

  // Map Database headers
  const dbHeaders = dbSheet.getRange(1, 1, 1, dbSheet.getLastColumn()).getValues()[0];
  const dbColMap = {};
  dbHeaders.forEach((h, idx) => {
    if (h) dbColMap[String(h).trim().toLowerCase()] = idx + 1;
  });

  // Next available row in Tickets
  const nextDbRow = dbSheet.getLastRow() + 1;
  const ticketIdCol = dbColMap['ticket id'];

  // 1. Generate atomic sequential Ticket ID
  const ticketId = getOrGenerateTicketId(dbSheet, nextDbRow, ticketIdCol);

  // 2. Populate fields into Tickets
  const setDbVal = (colKey, val) => {
    const col = dbColMap[colKey.toLowerCase()];
    if (col) dbSheet.getRange(nextDbRow, col).setValue(val);
  };

  setDbVal("Timestamp", timestamp);
  setDbVal("Email Address", email);
  setDbVal("Siglum", siglum);
  setDbVal("Summary", summary);
  setDbVal("Description", description);
  setDbVal("Criticality", criticality);
  setDbVal("Urgency", urgency);
  setDbVal("Request type", requestType);
  setDbVal("Attach file", attachFile);
  setDbVal("Status", status);

  SpreadsheetApp.flush();

  // 3. Audit trail
  logToTicketHistory(ticketId, "Ticket Created", "(New Ticket)", "Created via Google Form");
}

// ==========================================
// 3. EDIT HANDLER (ON SPREADSHEET EDIT)
// ==========================================

function handleSpreadsheetEdit(e) {
  if (!e || !e.range) return;

  const sheet = e.range.getSheet();
  if (sheet.getName() !== "Tickets") return;

  const row = e.range.getRow();
  const col = e.range.getColumn();

  if (row <= 1) return; // Ignore header edits

  // 1. Map columns dynamically from Row 1
  const headers = sheet.getRange(1, 1, 1, sheet.getLastColumn()).getValues()[0];
  const colMap = {};
  headers.forEach((h, idx) => {
    if (h && typeof h === 'string') {
      colMap[h.trim().toLowerCase()] = idx + 1;
    }
  });

  const ticketIdCol = colMap['ticket id'];
  if (!ticketIdCol) return;

  // 2. Ensure Ticket ID exists and is permanent
  const ticketId = getOrGenerateTicketId(sheet, row, ticketIdCol);

  // If user edited the Ticket ID column itself, ignore
  if (col === ticketIdCol) return;

  const editedHeaderName = headers[col - 1] ? String(headers[col - 1]).trim() : `Column ${col}`;

  // 3. Fetch current row data
  const rowData = sheet.getRange(row, 1, 1, headers.length).getValues()[0];
  const getVal = (key) => {
    const c = colMap[key];
    return (c && rowData[c - 1] !== undefined && rowData[c - 1] !== null) ? String(rowData[c - 1]).trim() : '';
  };

  const summary         = getVal('summary') || '(Untitled Request)';
  const requesterEmail  = getVal('email address');
  const siglum          = getVal('siglum');
  const description     = getVal('description') || 'No description provided.';
  const criticality     = getVal('criticality') || 'Medium';
  const urgentIndicator = getVal('urgency') || 'Default';
  const requestType     = getVal('request type') || '-';
  const status          = getVal('status') || 'To Do';

  // Support both "assignee" and "assignee name"
  const assigneeName    = getVal('assignee') || getVal('assignee name');

  // Look up Assignee Email from Tickets sheet first; if not present, look up from "Team" sheet
  let assigneeEmail     = getVal('assignee email');
  if (!assigneeEmail && assigneeName) {
    assigneeEmail = lookupAssigneeEmailFromTeam(sheet.getParent(), assigneeName);
  }

  // Values before and after
  const oldValue = e.oldValue !== undefined ? String(e.oldValue) : '(Empty)';
  const newValue = e.value !== undefined ? String(e.value) : String(rowData[col - 1] || '');

  if (oldValue === newValue) return;

  // 4. Log change to the "Ticket History" tab
  logToTicketHistory(ticketId, editedHeaderName, oldValue, newValue);

  // 5. Send email notifications if Status or Assignee was updated
  const STATUS_COL = colMap['status'];
  const ASSIGNEE_COL = colMap['assignee'] || colMap['assignee name'];
  const ASSIGNEE_EMAIL_COL = colMap['assignee email'];

  const isStatusChange = (col === STATUS_COL);
  const isAssignment   = (col === ASSIGNEE_COL || (ASSIGNEE_EMAIL_COL && col === ASSIGNEE_EMAIL_COL));

  if (isStatusChange || isAssignment) {
    sendNotificationEmail({
      ticketId,
      summary,
      requesterEmail,
      siglum,
      description,
      criticality,
      urgentIndicator,
      requestType,
      status,
      assigneeName,
      assigneeEmail,
      isStatusChange,
      isAssignment
    });
  }
}

/**
 * Looks up the agent's email address in the "Team" tab by matching Name or Assignee handle.
 */
function lookupAssigneeEmailFromTeam(spreadsheet, assigneeName) {
  if (!assigneeName) return '';
  const teamSheet = spreadsheet.getSheetByName("Team");
  if (!teamSheet || teamSheet.getLastRow() <= 1) return '';

  const teamData = teamSheet.getDataRange().getValues();
  const teamHeaders = teamData[0].map(h => String(h).trim().toLowerCase());

  const nameIdx = teamHeaders.findIndex(h => h === "assignee name" || h === "assignee");
  const emailIdx = teamHeaders.findIndex(h => h === "assignee email" || h === "email");

  if (nameIdx === -1 || emailIdx === -1) return '';

  const target = assigneeName.trim().toLowerCase();
  for (let i = 1; i < teamData.length; i++) {
    const currentName = String(teamData[i][nameIdx] || '').trim().toLowerCase();
    if (currentName === target) {
      return String(teamData[i][emailIdx] || '').trim();
    }
  }
  return '';
}

// ==========================================
// 4. AUDIT TRAIL LOGGING
// ==========================================

function logToTicketHistory(ticketId, fieldModified, oldValue, newValue) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  let historySheet = ss.getSheetByName("Ticket History");

  if (!historySheet || historySheet.getLastRow() === 0) {
    if (!historySheet) historySheet = ss.insertSheet("Ticket History");
    historySheet.appendRow(["Timestamp", "Ticket ID", "Field Modified", "Old Value", "New Value", "Modified By"]);
    historySheet.getRange("A1:F1").setFontWeight("bold").setBackground("#f1f5f9");
    historySheet.setFrozenRows(1);
  }

  const user = Session.getActiveUser().getEmail() || "Portal User";
  const now = new Date();

  historySheet.appendRow([
    now,
    ticketId,
    fieldModified,
    oldValue,
    newValue,
    user
  ]);
}

// ==========================================
// 5. EMAIL NOTIFICATIONS
// ==========================================

function sendNotificationEmail(t) {
  const isUrgent = (t.urgentIndicator || '').toUpperCase().includes('URGENT') || 
                   (t.criticality || '').toLowerCase() === 'high';

  const detailsTable = `
    <table style="width: 100%; border-collapse: collapse; margin: 18px 0; font-size: 13px;">
      <tr style="background-color: #f8fafc;">
        <td style="padding: 10px 12px; font-weight: 600; width: 32%; border-bottom: 1px solid #e2e8f0; color: #64748b;">Ticket ID:</td>
        <td style="padding: 10px 12px; border-bottom: 1px solid #e2e8f0; font-weight: 700; color: #4338ca;">${t.ticketId}</td>
      </tr>
      <tr>
        <td style="padding: 10px 12px; font-weight: 600; border-bottom: 1px solid #e2e8f0; color: #64748b;">Summary:</td>
        <td style="padding: 10px 12px; border-bottom: 1px solid #e2e8f0; font-weight: 600; color: #0f172a;">${t.summary}</td>
      </tr>
      <tr style="background-color: #f8fafc;">
        <td style="padding: 10px 12px; font-weight: 600; border-bottom: 1px solid #e2e8f0; color: #64748b;">Current Status:</td>
        <td style="padding: 10px 12px; border-bottom: 1px solid #e2e8f0;">
          <span style="background-color: #e0e7ff; color: #3730a3; padding: 3px 10px; border-radius: 6px; font-weight: 700; font-size: 12px;">${t.status}</span>
        </td>
      </tr>
      <tr>
        <td style="padding: 10px 12px; font-weight: 600; border-bottom: 1px solid #e2e8f0; color: #64748b;">Priority / Urgency:</td>
        <td style="padding: 10px 12px; border-bottom: 1px solid #e2e8f0;">
          ${t.criticality} ${isUrgent ? ' - <strong style="color: #dc2626; background: #fee2e2; padding: 2px 6px; border-radius: 4px;">URGENT</strong>' : ''}
        </td>
      </tr>
      <tr style="background-color: #f8fafc;">
        <td style="padding: 10px 12px; font-weight: 600; border-bottom: 1px solid #e2e8f0; color: #64748b;">Assigned Agent:</td>
        <td style="padding: 10px 12px; border-bottom: 1px solid #e2e8f0; color: #0f172a;">
          ${t.assigneeName ? `${t.assigneeName} (${t.assigneeEmail || 'No email registered'})` : '<em>Currently Unassigned</em>'}
        </td>
      </tr>
      <tr>
        <td style="padding: 10px 12px; font-weight: 600; vertical-align: top; color: #64748b;">Description:</td>
        <td style="padding: 10px 12px; white-space: pre-wrap; color: #334155; line-height: 1.5;">${t.description}</td>
      </tr>
    </table>
  `;

  // Status Change -> Email Requester (and CC Assignee)
  if (t.isStatusChange && t.requesterEmail && t.requesterEmail.includes('@')) {
    const subject = `[BMS Support] Update on Ticket ${t.ticketId}: Status changed to [${t.status}]`;
    let statusMessage = `The status of your request has been updated to: ${t.status}.`;
    let bannerColor = '#2563eb';

    if (t.status === 'Done') {
      bannerColor = '#059669';
      statusMessage = 'Your support request has been completed and marked as Done. If you require further assistance, please reply to this email.';
    } else if (t.status === 'Validation') {
      bannerColor = '#d97706';
      statusMessage = 'Your support request is currently in Validation awaiting verification or user acceptance.';
    } else if (t.status === 'In Progress') {
      bannerColor = '#2563eb';
      statusMessage = 'The BMS Support team has begun active investigation on your request.';
    }

    const htmlBody = `
      <div style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; color: #1e293b; max-width: 620px; border: 1px solid #e2e8f0; border-radius: 12px; overflow: hidden; margin: 0 auto;">
        <div style="background-color: ${bannerColor}; color: #ffffff; padding: 20px 24px;">
          <span style="font-size: 11px; text-transform: uppercase; letter-spacing: 0.06em; opacity: 0.9; font-weight: 600;">BMS Support Line</span>
          <h2 style="margin: 4px 0 0 0; font-size: 18px; font-weight: 700; color: #ffffff;">Ticket Status Update</h2>
        </div>
        <div style="padding: 24px; font-size: 14px; line-height: 1.6;">
          <p style="margin-top: 0;">Hello,</p>
          <p style="color: #334155;">${statusMessage}</p>
          ${detailsTable}
          <p style="margin-top: 24px; font-size: 12px; color: #94a3b8; border-top: 1px solid #f1f5f9; padding-top: 14px;">
            This is an automated notification from the BMS Support Line.
          </p>
        </div>
      </div>
    `;

    try {
      const options = { htmlBody };
      if (t.assigneeEmail && t.assigneeEmail.includes('@') && t.assigneeEmail !== t.requesterEmail) {
        options.cc = t.assigneeEmail;
      }
      GmailApp.sendEmail(t.requesterEmail, subject, t.summary, options);
    } catch (err) {
      console.error('Failed to email requester: ' + err.message);
    }
  }

  // New Assignment -> Email Assignee
  if (t.isAssignment && t.assigneeEmail && t.assigneeEmail.includes('@')) {
    const subject = `[BMS Support] New Assignment: ${t.ticketId} - ${t.summary}`;
    const htmlBody = `
      <div style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; color: #1e293b; max-width: 620px; border: 1px solid #e2e8f0; border-radius: 12px; overflow: hidden; margin: 0 auto;">
        <div style="background-color: #4338ca; color: #ffffff; padding: 20px 24px;">
          <span style="font-size: 11px; text-transform: uppercase; letter-spacing: 0.06em; opacity: 0.9; font-weight: 600;">BMS Support Line</span>
          <h2 style="margin: 4px 0 0 0; font-size: 18px; font-weight: 700; color: #ffffff;">New Ticket Assigned to You</h2>
        </div>
        <div style="padding: 24px; font-size: 14px; line-height: 1.6;">
          <p style="margin-top: 0;">Hello <strong>${t.assigneeName || 'Colleague'}</strong>,</p>
          <p style="color: #334155;">
            You have been assigned as the lead agent for ticket <strong style="color: #4338ca;">${t.ticketId}</strong>.
          </p>
          ${detailsTable}
          <p style="margin-top: 24px; font-size: 12px; color: #94a3b8; border-top: 1px solid #f1f5f9; padding-top: 14px;">
            This is an automated notification from the BMS Support Line.
          </p>
        </div>
      </div>
    `;

    try {
      GmailApp.sendEmail(t.assigneeEmail, subject, t.summary, { htmlBody });
      console.log(`Assignment notification email successfully sent to: ${t.assigneeEmail}`);
    } catch (err) {
      console.error('Failed to email assignee: ' + err.message);
    }
  } else if (t.isAssignment && (!t.assigneeEmail || !t.assigneeEmail.includes('@'))) {
    console.warn(`Assignee changed to "${t.assigneeName}", but no valid email address was found in the Team tab.`);
  }
}
