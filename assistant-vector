function doGet() {
  return HtmlService.createHtmlOutputFromFile('Index')
    .setTitle('DAISEI Vector RAG')
    .setXFrameOptionsMode(HtmlService.XFrameOptionsMode.ALLOWALL);
}

const INDEX_FILE_NAME = "daisei_vector_index.json";

// 1. Liste les fichiers du dossier (hors fichier d'index)
function getFolderFileList(folderId) {
  if (!folderId) return { error: "ID de dossier manquant." };

  try {
    const folder = DriveApp.getFolderById(folderId);
    const files = folder.getFiles();
    let list = [];

    while (files.hasNext()) {
      const file = files.next();
      const name = file.getName();
      const mime = file.getMimeType();

      if (name === INDEX_FILE_NAME) continue;

      if (
        mime === MimeType.GOOGLE_DOCS ||
        mime === MimeType.PLAIN_TEXT ||
        mime === "text/csv" ||
        mime === MimeType.PDF
      ) {
        list.push({
          id: file.getId(),
          name: name,
          mimeType: mime
        });
      }
    }
    return { files: list };
  } catch (err) {
    return { error: "Erreur d'accès au dossier : " + err.message };
  }
}

// 2. Récupère le contenu d'un seul fichier à la fois
function getSingleFilePayload(fileId) {
  try {
    const file = DriveApp.getFileById(fileId);
    const mime = file.getMimeType();

    if (mime === MimeType.GOOGLE_DOCS) {
      return { type: "text", content: DocumentApp.openById(fileId).getBody().getText() };
    } else if (mime === MimeType.PLAIN_TEXT || mime === "text/csv") {
      return { type: "text", content: file.getBlob().getDataAsString() };
    } else if (mime === MimeType.PDF) {
      return { type: "pdf", base64: Utilities.base64Encode(file.getBlob().getBytes()) };
    }
    return { type: "skip" };
  } catch (err) {
    return { error: err.message };
  }
}

// 3. Sauvegarde l'index vectoriel sur Google Drive pour ne pas recalculer à chaque fois
function saveVectorIndexToDrive(folderId, jsonString) {
  try {
    const folder = DriveApp.getFolderById(folderId);
    const existing = folder.getFilesByName(INDEX_FILE_NAME);
    
    if (existing.hasNext()) {
      const file = existing.next();
      file.setContent(jsonString);
    } else {
      folder.createFile(INDEX_FILE_NAME, jsonString, MimeType.PLAIN_TEXT);
    }
    return { success: true };
  } catch (err) {
    return { error: err.message };
  }
}

// 4. Charge l'index vectoriel existant depuis Google Drive
function loadVectorIndexFromDrive(folderId) {
  try {
    const folder = DriveApp.getFolderById(folderId);
    const existing = folder.getFilesByName(INDEX_FILE_NAME);
    
    if (existing.hasNext()) {
      const file = existing.next();
      return { exists: true, content: file.getBlob().getDataAsString() };
    }
    return { exists: false };
  } catch (err) {
    return { error: err.message };
  }
}




<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <title>DAISEI Vector RAG Chat</title>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/2.16.105/pdf.min.js"></script>
  <script>
    pdfjsLib.GlobalWorkerOptions.workerSrc = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/2.16.105/pdf.worker.min.js';
  </script>
  <style>
    body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; margin: 0; display: flex; height: 100vh; background-color: #f8f9fa; }
    #sidebar { width: 340px; background: #fff; border-right: 1px solid #e0e0e0; padding: 18px; box-sizing: border-box; display: flex; flex-direction: column; gap: 10px; overflow-y: auto; }
    #chat-container { flex: 1; display: flex; flex-direction: column; height: 100vh; }
    #messages { flex: 1; overflow-y: auto; padding: 24px; display: flex; flex-direction: column; gap: 16px; }
    .message { max-width: 75%; padding: 12px 16px; border-radius: 8px; font-size: 14px; line-height: 1.5; white-space: pre-wrap; }
    .user { align-self: flex-end; background-color: #0b57d0; color: white; }
    .assistant { align-self: flex-start; background-color: white; border: 1px solid #e0e0e0; color: #1f1f1f; }
    .system-info { align-self: center; font-size: 12px; color: #555; background: #eef3fc; padding: 6px 12px; border-radius: 12px; }
    #input-area { padding: 16px 24px; background: white; border-top: 1px solid #e0e0e0; display: flex; gap: 12px; }
    textarea { flex: 1; resize: none; height: 48px; padding: 10px; border-radius: 6px; border: 1px solid #ccc; font-family: inherit; font-size: 14px; }
    button { padding: 9px 14px; border: none; background: #0b57d0; color: white; border-radius: 6px; font-weight: bold; cursor: pointer; font-size: 13px; }
    button.secondary { background: #4a5568; }
    button.outline { background: transparent; color: #0b57d0; border: 1px solid #0b57d0; }
    button:disabled { background: #ccc; cursor: not-allowed; }
    input { width: 100%; box-sizing: border-box; padding: 7px; border: 1px solid #ccc; border-radius: 4px; font-size: 13px; margin-top: 3px; }
    label { font-size: 12px; font-weight: bold; color: #333; display: block; }
    .badge { font-size: 12px; padding: 6px 8px; border-radius: 4px; background: #eee; color: #333; }
    .badge.ok { background: #d4edda; color: #155724; }
    #modelListBox { font-size: 11px; max-height: 110px; overflow-y: auto; background: #f1f3f4; padding: 6px; border-radius: 4px; display: none; white-space: pre-wrap; }
  </style>
</head>
<body>

  <div id="sidebar">
    <h3 style="margin: 0 0 4px 0;">Configuration RAG Vectoriel</h3>
    
    <div>
      <label>Clé API DAISEI :</label>
      <input type="password" id="apiKey" placeholder="sk-...">
    </div>

    <button class="outline" onclick="listModels()">🔍 Lister les modèles DAISEI</button>
    <div id="modelListBox"></div>

    <div>
      <label>Modèle de Chat :</label>
      <input type="text" id="chatModel" placeholder="ex: mistral-small-24b-instruct-2501">
    </div>

    <div>
      <label>Modèle d'Embedding :</label>
      <input type="text" id="embedModel" placeholder="ex: bge-m3 ou text-embedding...">
    </div>

    <div>
      <label>ID Dossier Google Drive :</label>
      <input type="text" id="folderId" placeholder="ID du dossier">
    </div>

    <hr style="width:100%; border:0; border-top:1px solid #ddd;">

    <div id="indexStatus" class="badge">Index : Non chargé</div>
    <button class="secondary" id="loadIndexBtn" onclick="loadExistingIndex()">📂 Charger l'index existant</button>
    <button id="buildIndexBtn" onclick="buildVectorIndex()">⚙️ Vectoriser / Indexer le dossier</button>
  </div>

  <div id="chat-container">
    <div id="messages">
      <div class="message assistant">Bonjour ! 
1. Renseignez votre clé API, vos modèles (Chat et Embedding) et l'ID du dossier Drive.
2. Cliquez sur <b>Vectoriser / Indexer le dossier</b> (ou <b>Charger l'index existant</b> si déjà fait).
3. Posez vos questions : seuls les extraits vectoriels les plus pertinents seront envoyés au modèle !</div>
    </div>
    <div id="input-area">
      <textarea id="userInput" placeholder="Posez une question sur vos documents..."></textarea>
      <button id="sendBtn" onclick="handleSend()">Envoyer</button>
    </div>
  </div>

  <script>
    const BASE_URL = "https://daisei-api.ad6d-daiseicloudlab.aws.cloud.airbus.corp/api/v1";
    let vectorStore = []; // Contient [{ source, text, embedding: [...] }]
    let conversationHistory = [];

    function appendMessage(role, text) {
      const container = document.getElementById("messages");
      const msg = document.createElement("div");
      msg.className = `message ${role}`;
      msg.innerText = text;
      container.appendChild(msg);
      container.scrollTop = container.scrollHeight;
      return msg;
    }

    function updateBadge(text, isOk) {
      const badge = document.getElementById("indexStatus");
      badge.innerText = text;
      badge.className = isOk ? "badge ok" : "badge";
    }

    // Interroge /v1/models pour aider à trouver le nom exact du modèle d'embedding et de chat
    async function listModels() {
      const apiKey = document.getElementById("apiKey").value.trim();
      const box = document.getElementById("modelListBox");
      if (!apiKey) { alert("Renseignez d'abord la clé API."); return; }

      box.style.display = "block";
      box.innerText = "Chargement des modèles...";
      try {
        const res = await fetch(`${BASE_URL}/models`, {
          headers: { "Authorization": "Bearer " + apiKey }
        });
        const data = await res.json();
        if (data.data && Array.isArray(data.data)) {
          box.innerText = data.data.map(m => "• " + m.id).join("\n");
        } else {
          box.innerText = JSON.stringify(data, null, 2);
        }
      } catch (e) {
        box.innerText = "Erreur : " + e.message;
      }
    }

    // Découpe un long texte en petits paragraphes (chunks) de ~800 caractères
    function splitTextIntoChunks(text, chunkSize = 800, overlap = 150) {
      const cleaned = text.replace(/\s+/g, " ").trim();
      if (!cleaned) return [];
      const chunks = [];
      let start = 0;
      while (start < cleaned.length) {
        chunks.push(cleaned.slice(start, start + chunkSize));
        start += chunkSize - overlap;
      }
      return chunks;
    }

    // Appelle l'endpoint /v1/embeddings de DAISEI
    async function getEmbeddings(inputTexts, apiKey, embedModel) {
      const response = await fetch(`${BASE_URL}/embeddings`, {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
          "Authorization": "Bearer " + apiKey
        },
        body: JSON.stringify({
          model: embedModel,
          input: inputTexts
        })
      });

      if (!response.ok) {
        throw new Error(`Erreur Embedding HTTP ${response.status}: ${await response.text()}`);
      }
      const json = await response.json();
      return json.data.map(item => item.embedding);
    }

    // Calcule la similarité cosinus entre deux vecteurs
    function cosineSimilarity(vecA, vecB) {
      let dot = 0.0, normA = 0.0, normB = 0.0;
      for (let i = 0; i < vecA.length; i++) {
        dot += vecA[i] * vecB[i];
        normA += vecA[i] * vecA[i];
        normB += vecB[i] * vecB[i];
      }
      if (normA === 0 || normB === 0) return 0;
      return dot / (Math.sqrt(normA) * Math.sqrt(normB));
    }

    // Extraction PDF complète page par page
    async function extractTextFromPDFBase64(base64Data) {
      const binaryString = atob(base64Data);
      const bytes = new Uint8Array(binaryString.length);
      for (let i = 0; i < binaryString.length; i++) {
        bytes[i] = binaryString.charCodeAt(i);
      }
      const pdf = await pdfjsLib.getDocument({ data: bytes.buffer }).promise;
      let fullText = "";
      for (let i = 1; i <= pdf.numPages; i++) {
        const page = await pdf.getPage(i);
        const content = await page.getTextContent();
        fullText += content.items.map(item => item.str).join(" ") + "\n";
      }
      return fullText;
    }

    function runAppsScript(fnName, ...args) {
      return new Promise((resolve, reject) => {
        google.script.run
          .withSuccessHandler(resolve)
          .withFailureHandler(reject)[fnName](...args);
      });
    }

    // Charge un index déjà calculé et sauvegardé sur le Drive
    async function loadExistingIndex() {
      const folderId = document.getElementById("folderId").value.trim();
      if (!folderId) { alert("Renseignez l'ID du dossier Drive."); return; }

      updateBadge("Recherche de l'index sur Drive...", false);
      try {
        const res = await runAppsScript("loadVectorIndexFromDrive", folderId);
        if (res.error) throw new Error(res.error);
        if (!res.exists) {
          updateBadge("Aucun index trouvé sur Drive.", false);
          alert("Aucun fichier d'index trouvé dans ce dossier. Cliquez sur 'Vectoriser / Indexer le dossier'.");
          return;
        }
        vectorStore = JSON.parse(res.content);
        updateBadge(`Index prêt (${vectorStore.length} chunks)`, true);
      } catch (err) {
        updateBadge("Erreur chargement index", false);
        alert("Erreur : " + err.message);
      }
    }

    // Lit tous les fichiers un par un, les découpe, calcule les embeddings et sauvegarde sur Drive
    async function buildVectorIndex() {
      const apiKey = document.getElementById("apiKey").value.trim();
      const embedModel = document.getElementById("embedModel").value.trim();
      const folderId = document.getElementById("folderId").value.trim();

      if (!apiKey || !embedModel || !folderId) {
        alert("Veuillez remplir la clé API, le modèle d'Embedding et l'ID du dossier.");
        return;
      }

      document.getElementById("buildIndexBtn").disabled = true;
      const infoMsg = appendMessage("system-info", "Démarrage de l'indexation vectorielle...");

      try {
        const listRes = await runAppsScript("getFolderFileList", folderId);
        if (listRes.error) throw new Error(listRes.error);

        const files = listRes.files;
        if (!files || files.length === 0) {
          infoMsg.innerText = "Aucun fichier compatible trouvé dans le dossier.";
          document.getElementById("buildIndexBtn").disabled = false;
          return;
        }

        let newStore = [];

        for (let i = 0; i < files.length; i++) {
          const f = files[i];
          infoMsg.innerText = `[${i + 1}/${files.length}] Extraction du texte : ${f.name}...`;
          const payload = await runAppsScript("getSingleFilePayload", f.id);
          if (payload.error) continue;

          let rawText = "";
          if (payload.type === "text") rawText = payload.content;
          else if (payload.type === "pdf") rawText = await extractTextFromPDFBase64(payload.base64);

          const chunks = splitTextIntoChunks(rawText, 800, 150);
          if (chunks.length === 0) continue;

          // Vectorisation par petits lots de 10 chunks pour ne jamais saturer l'API
          const batchSize = 10;
          for (let b = 0; b < chunks.length; b += batchSize) {
            const batchChunks = chunks.slice(b, b + batchSize);
            infoMsg.innerText = `[${i + 1}/${files.length}] Vectorisation ${f.name} (chunks ${b + 1}-${Math.min(b + batchSize, chunks.length)}/${chunks.length})...`;
            
            const embeddings = await getEmbeddings(batchChunks, apiKey, embedModel);
            for (let k = 0; k < batchChunks.length; k++) {
              newStore.push({
                source: f.name,
                text: batchChunks[k],
                embedding: embeddings[k]
              });
            }
          }
        }

        vectorStore = newStore;
        infoMsg.innerText = `Sauvegarde de l'index (${vectorStore.length} vecteurs) dans Google Drive...`;
        await runAppsScript("saveVectorIndexToDrive", folderId, JSON.stringify(vectorStore));

        updateBadge(`Index prêt (${vectorStore.length} chunks)`, true);
        infoMsg.innerText = `✅ Indexation terminée avec succès ! ${vectorStore.length} segments vectorisés et sauvegardés sur Drive.`;

      } catch (err) {
        infoMsg.innerText = "❌ Erreur lors de l'indexation : " + err.message;
      } finally {
        document.getElementById("buildIndexBtn").disabled = false;
      }
    }

    // Recherche vectorielle + Appel au modèle de Chat
    async function handleSend() {
      const input = document.getElementById("userInput");
      const apiKey = document.getElementById("apiKey").value.trim();
      const chatModel = document.getElementById("chatModel").value.trim();
      const embedModel = document.getElementById("embedModel").value.trim();
      const query = input.value.trim();

      if (!query) return;
      if (!apiKey || !chatModel || !embedModel) {
        alert("Veuillez renseigner la clé API, le modèle de Chat et le modèle d'Embedding.");
        return;
      }
      if (vectorStore.length === 0) {
        alert("L'index vectoriel est vide. Cliquez d'abord sur 'Charger l'index existant' ou 'Vectoriser le dossier'.");
        return;
      }

      appendMessage("user", query);
      input.value = "";
      document.getElementById("sendBtn").disabled = true;

      const loader = appendMessage("system-info", "Vectorisation de la question et recherche sémantique...");

      try {
        // 1. Vectorise la question de l'utilisateur
        const [queryVector] = await getEmbeddings([query], apiKey, embedModel);

        // 2. Calcule la similarité avec tous les segments de documents
        const scoredChunks = vectorStore.map(item => ({
          source: item.source,
          text: item.text,
          score: cosineSimilarity(queryVector, item.embedding)
        }));

        // 3. Trie et garde les 5 meilleurs extraits (Top-K = 5)
        scoredChunks.sort((a, b) => b.score - a.score);
        const topK = scoredChunks.slice(0, 5);

        const contextBlock = topK.map((c, idx) => 
          `[Extrait ${idx + 1} | Source: ${c.source} | Pertinence: ${(c.score * 100).toFixed(1)}%]\n${c.text}`
        ).join("\n\n");

        loader.innerText = "Interrogation du modèle DAISEI avec les 5 meilleurs extraits...";

        const ragPrompt = `Tu es un assistant expert. Réponds à la question de l'utilisateur en t'appuyant sur les extraits de documents fournis ci-dessous. Cite toujours le nom du fichier source utilisé.\n\n=== EXTRAITS PERTINENTS ===\n${contextBlock}\n\n=== QUESTION ===\n${query}`;

        conversationHistory.push({ role: "user", content: ragPrompt });

        // 4. Envoie au modèle de Chat (uniquement les 5 extraits pertinents !)
        const response = await fetch(`${BASE_URL}/chat/completions`, {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
            "Authorization": "Bearer " + apiKey
          },
          body: JSON.stringify({
            model: chatModel,
            messages: conversationHistory.slice(-6) // Garde les derniers échanges pour rester léger
          })
        });

        if (!response.ok) {
          throw new Error(`HTTP ${response.status}: ${await response.text()}`);
        }

        const data = await response.json();
        const reply = data.choices[0].message.content.trim();

        loader.remove();
        appendMessage("assistant", reply);
        conversationHistory.push({ role: "assistant", content: reply });

      } catch (err) {
        loader.innerText = "❌ Erreur : " + err.message;
      } finally {
        document.getElementById("sendBtn").disabled = false;
      }
    }
  </script>
</body>
</html>
