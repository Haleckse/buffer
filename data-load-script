Temp_Hist_Country_Split:
LOAD 
    [Project ID],
  // Step 1: We bring back the normal spaces for countries with two words.
    Replace(Trim(SubField_Country), '_', ' ') AS Clean_Country_Element
;
LOAD 
    [Project ID],
    // Step 2: We split the text every time there is a commas
    Trim(SubField(Comma_String, ',')) AS SubField_Country
;
LOAD 
    [Project ID],
    // Step 3: We protect countries with two words (like "UNITED KINGDOM") by adding an underscore so they don't get split.
    Replace(Replace(Replace(Replace(Replace(Replace(Replace(Replace(Replace(Replace(Replace(Replace(
        Protected_String
    , Chr(160), ','), Chr(10), ','), Chr(13), ','), Chr(9), ','), ' ', ','), '&', ','), '+', ','), '-', ','), '/', ','), ';', ','), '\n', ','), '\r', ',') AS Comma_String
;
LOAD 
    [Project ID],
    // Applying the official dictionary to translate the old countries
    Replace(Replace(Replace(Replace(Replace(Replace(Replace(
        Trim([Hist_Country_Raw_String])
    , 'UNITED KINGDOM', 'UNITED_KINGDOM')
    , 'UNITED STATES', 'UNITED_STATES')
    , 'SAUDI ARABIA', 'SAUDI_ARABIA')
    , 'SOUTH AFRICA', 'SOUTH_AFRICA')
    , 'NEW ZEALAND', 'NEW_ZEALAND')
    , 'CZECH REPUBLIC', 'CZECH_REPUBLIC')
    , 'COSTA RICA', 'COSTA_RICA') AS Protected_String
RESIDENT Hist_Projects
WHERE Len(Trim([Hist_Country_Raw_String])) > 0;

Bridge_Project_Country: 
LOAD DISTINCT
    [Project ID],
    
    ApplyMap('Map_Country_Label', 
        ApplyMap('Map_Country_ISO', Clean_Country_Element, Capitalize(Clean_Country_Element))
    , Capitalize(Clean_Country_Element)) AS [Country_Label],
    
    ApplyMap('Map_Country_ISO', Clean_Country_Element, Clean_Country_Element) AS [Country_Final]

RESIDENT Temp_Hist_Country_Split
WHERE Len(Trim(Clean_Country_Element)) > 0;

DROP TABLE Temp_Hist_Country_Split;


