    skipRows=''
);

// ===========================================================================
// --- 2. SEPARATING EN9100 STANDARDS ---
// We split the standard codes into chapters and use our dictionary to translate them.
// ===========================================================================

Bridge_PPS_EN9100:
LOAD DISTINCT
    [%Key_Finding_Action],
    
    // Extracting the pure chapter numbers (Level 0 and Level 1)
    SubField([EN9100_Chapter_Code], '.', 1) AS [EN9100_L0],
    If(SubStringCount([EN9100_Chapter_Code], '.') >= 1, 
        SubField([EN9100_Chapter_Code], '.', 1) & '.' & SubField([EN9100_Chapter_Code], '.', 2), 
        [EN9100_Chapter_Code]
    ) AS [EN9100_L1],
    
    // 🟢 Translating the numbers into readable chapter names using the dictionary
    ApplyMap('Map_Chapter_L0', Trim(SubField([EN9100_Chapter_Code], '.', 1)), 'Other') AS [Chapter_L0_Name],
    ApplyMap('Map_Chapter_L1', Trim(If(SubStringCount([EN9100_Chapter_Code], '.') >= 1, SubField([EN9100_Chapter_Code], '.', 1) & '.' & SubField([EN9100_Chapter_Code], '.', 2), [EN9100_Chapter_Code])), 'Other') AS [Chapter_L1_Name],

    // Keeping the original unedited text
    [EN9100_Chapter_Code],
    [EN9100_Full_Label];
LOAD DISTINCT
    [%Key_Finding_Action],
    Trim(SubField(Trim(SubField(Replace(Replace([Raw_EN9100], '&', ';'), ',', ';'), ';')), ' ', 1)) AS [EN9100_Chapter_Code],
    SubField(Replace(Replace([Raw_EN9100], '&', ';'), ',', ';'), ';') AS [EN9100_Full_Label]
RESIDENT Temp_RetrievePPS_Base
WHERE Len(Trim([Raw_EN9100])) > 0;

// ===========================================================================
