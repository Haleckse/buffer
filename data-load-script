/* ===========================================================================
   --- 3. CREATING THE DEPARTMENT BRIDGE TABLE ---
   We translate the short Department Codes (Siglum) into full names.
   =========================================================================== */
[APL_Bridge_Table]:
LOAD 
    [%Key_Finding_Action],
    [APL_Siglum_Atomic],
    [APL_Siglum_Group_5L],
    
   // DOUBLE TRANSLATION: If the 5-letter code isn't in the dictionary, 
    // we try searching for the 4-letter version
    ApplyMap('Map_APL_Department_Names', [APL_Siglum_Group_5L], 
        ApplyMap('Map_APL_Department_Names', Left([APL_Siglum_Group_5L], 4), 
            [APL_Siglum_Group_5L]
        )
    ) AS [APL_Department_Full_Name];

LOAD DISTINCT
    [Finding id] AS [%Key_Finding_Action], // 🟢 LA BONNE LIAISON
    
    // Splitting multiple department codes
    Upper(Trim(SubField(Replace(Replace(Replace(Replace([APL_Siglum_Raw], ';', ','), '/', ','), '&', ','), ' AND ', ','), ','))) AS [APL_Siglum_Atomic],
    
    // Creating a standard 5-letter code for the dictionary
    Left(PurgeChar(Upper(Trim(SubField(Replace(Replace(Replace(Replace([APL_Siglum_Raw], ';', ','), '/', ','), '&', ','), ' AND ', ','), ','))), ' .-_/#&'), 5) AS [APL_Siglum_Group_5L]

RESIDENT [Doc_04_Actions]
WHERE 
    Len(Trim([APL_Siglum_Raw])) > 0 
    AND NOT Match(Upper(Trim([APL_Siglum_Raw])), '0', 'N/A', '-');

