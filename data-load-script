Map_Audit_No:
MAPPING LOAD DISTINCT 
    Trim([Project ID]), 
    Trim([Audit No]) 
FROM [lib://AttachedFiles/Doc_1_Projects.qvd] (qvd);

// --- B. IMPORTING RAW DATA FROM GOOGLE SHEETS ---
Temp_Findings_Raw:
SELECT * FROM GetSheetValues WITH PROPERTIES ( 
    spreadsheetKey='1XXsx_XYGRMkqh3c22ZhYSt5s8hYPZryZIwwY8PpGfXE', 
    range='03_-_Findings_Data', 
    valueRenderOption='FORMATTED_VALUE', 
    dateTimeRenderOption='FORMATTED_STRING', 
    generatedNumberedColumns='false', 
    skipRows='' 
);

// --- C. BUILDING THE MAIN FINDINGS TABLE ----
Doc_03_Findings:
LOAD Distinct
    // --- 1. THE BRIDGE KEYS ---
    Trim([Project ID]) AS [Project ID],
    Trim([Finding id]) AS [Finding id], 
    Trim([Objective id]) AS [Objective id], 
    Trim([Finding reference]) AS [Finding reference],
    // Clé manuelle de repli :
    Upper(PurgeChar(ApplyMap('Map_Audit_No', Trim([Project ID]), '') & Trim(If(IsNull([Finding reference]), '', [Finding reference])), ' .#<>-')) AS [Manual_Finding_Key],

    // --- 2. DESCRIPTIVE METADATA ---
    Trim([Finding title]) AS [Finding title],
    Trim([Finding owner]) AS [Finding owner],
    Trim([Finding deficiency type]) AS [Finding deficiency type],
    Trim([finding status]) AS [Finding Status],
    Trim([remediation status]) AS [remediation status],

    // --- 3. SEVERITY LEVEL GROUPING ---
    If(Len(Trim([Finding severity]))=0, Null(), Trim([Finding severity])) AS [Finding severity],
    If(WildMatch([Finding severity], '*1/Major*', '*Major*', '*Critical*', '*Serious*', '*Level 1*'), 'Level 1 - Major',
    If(WildMatch([Finding severity], '*2/Minor*', '*Minor*', '*Significant*', '*Level 2*'), 'Level 2 - Minor',
    If(WildMatch([Finding severity], '*3/Improvement*', '*Improvement*', '*OFI*', '*Level 3*'), 'Level 3 - Improvement',
    'Other'
    ))) AS [Severity Group],

    // --- 4. LONG TEXT CLEANING ---
    If(Len(Trim([Finding description]))=0, Null(), 
        Trim(Replace(Replace(Replace(ReplaceRegEx([Finding description], '<[^>]*>', ''), Chr(10), ' '), Chr(13), ' '), Chr(9), ' ')) 
    ) AS [Finding_Description_Clean],

    If(Len(Trim([Finding cause]))=0, Null(), 
        Trim(Replace(Replace(Replace(ReplaceRegEx([Finding cause], '<[^>]*>', ''), Chr(10), ' '), Chr(13), ' '), Chr(9), ' ')) 
    ) AS [Finding_Cause_Clean],

    If(Len(Trim([Remediation plan]))=0, Null(), 
        Trim(Replace(Replace(Replace(ReplaceRegEx([Remediation plan], '<[^>]*>', ''), Chr(10), ' '), Chr(13), ' '), Chr(9), ' ')) 
    ) AS [Remediation_Plan_Clean],

    If(Len(Trim([finding scope]))=0, Null(), 
        Trim(Replace(Replace(Replace(ReplaceRegEx([finding scope], '<[^>]*>', ''), Chr(10), ' '), Chr(13), ' '), Chr(9), ' ')) 
    ) AS [Finding_Scope_Clean],

    // --- 5. DATE FORMATTING & ERROR HANDLING ---
    If(WildMatch(Trim([Finding created at]), '*1899*'), Null(), Alt(Date#(Trim([Finding created at]), 'DD/MM/YYYY'), Date#(Trim([Finding created at]), 'YYYY-MM-DD'))) AS [Finding_Created_Date],
    If(WildMatch(Trim([Finding Date identified]), '*1899*'), Null(), Alt(Date#(Trim([Finding Date identified]), 'DD/MM/YYYY'), Date#(Trim([Finding Date identified]), 'YYYY-MM-DD'))) AS [Finding_Identified_Date],
    If(WildMatch(Trim([remediation date]), '*1899*'), Null(), Alt(Date#(Trim([remediation date]), 'DD/MM/YYYY'), Date#(Trim([remediation date]), 'YYYY-MM-DD'))) AS [Remediation_Target_Date],
    If(WildMatch(Trim([actual remediation date]), '*1899*'), Null(), Alt(Date#(Trim([actual remediation date]), 'DD/MM/YYYY'), Date#(Trim([actual remediation date]), 'YYYY-MM-DD'))) AS [Actual_Remediation_Date],
    If(WildMatch(Trim([Initial remediation date]), '*1899*'), Null(), Alt(Date#(Trim([Initial remediation date]), 'DD/MM/YYYY'), Date#(Trim([Initial remediation date]), 'YYYY-MM-DD'))) AS [Initial_Remediation_Date],
    
    If(Len(Trim([Extension date]))=0, Null(), Trim([Extension date])) AS [Extension_Requested_Text],
