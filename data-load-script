// If an issue has multiple causes, we separate them so the user can filter them individually.
// ===========================================================================

Bridge_PPS_Causes:
LOAD DISTINCT
    [%Key_Finding_Action],
    SubField(Replace(Trim([Raw_Causes]), ';', ','), ',') AS [Causes_Codes_Atomic]
RESIDENT Temp_RetrievePPS_Base
WHERE Len(Trim([Raw_Causes])) > 0;

// ===========================================================================
// --- 4. SEPARATING AQAP CODES ---
// ===========================================================================

Bridge_PPS_AQAP:
LOAD DISTINCT
    [%Key_Finding_Action],
SubField(Replace(Replace(Replace(Replace(Trim([Raw_AQAP]), Chr(10), ','), Chr(13), ','), '&', ','), ';', ','), ',') AS [AQAP_Atomic]
RESIDENT Temp_RetrievePPS_Base
WHERE Len(Trim([Raw_AQAP])) > 0;

// ===========================================================================
// --- 5. SEPARATING EMAR CODES ---
// ===========================================================================

Bridge_PPS_EMAR:
LOAD DISTINCT
    [%Key_Finding_Action],
SubField(Replace(Replace(Replace(Replace(Trim([Raw_EMAR]), Chr(10), ','), Chr(13), ','), '&', ','), ';', ','), ',') AS [EMAR_Atomic]
RESIDENT Temp_RetrievePPS_Base
WHERE Len(Trim([Raw_EMAR])) > 0;

// ===========================================================================
// --- 6. SEPARATING WEB LINKS ---
// ===========================================================================

Bridge_PPS_Links:
LOAD DISTINCT
    [%Key_Finding_Action],
    SubField(Trim([Raw_PPS_Link]), Chr(10)) AS [PPS_Link_Atomic]
RESIDENT Temp_RetrievePPS_Base
WHERE Len(Trim([Raw_PPS_Link])) > 0;


