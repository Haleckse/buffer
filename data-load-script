Temp_AD_Extract:
LOAD Distinct
    // --- 1. MAIN IDENTIFIERS ---
    Trim([Project id]) AS [Project ID],
    Trim([Audit No]) AS [Audit No],
    Trim([Control id]) AS [Control id], 

    // --- 2. EXTRA DETAILS ---
    Trim([Division Department]) AS [Division Department], 
    Trim([Finding Category]) AS [Finding Category], 
    Trim([root cause]) AS [AD_root cause], 
    Trim([Action submitted]) AS [Action submitted], 
    Trim([Action owner siglum]) AS [Action owner siglum], 
    Trim([Has comments]) AS [AD_Has_Comments],

    // --- 3. SEPARATING GROUPED WORDS ---
    SubField(Replace(Replace(Trim([related entities titles]), '&', ','), ';', ','), ',') AS [Entities_Related_Raw],

    // --- 4. DATES (Seules les baseline dates restent présentes dans cette source) ---
    If(WildMatch(Trim([planned start date]), '*1899*'), Null(), Alt(Date#(Trim([planned start date]), 'DD/MM/YYYY'), Date#(Trim([planned start date]), 'YYYY-MM-DD'))) AS [Baseline_Start_Date],
    If(WildMatch(Trim([planned end date]), '*1899*'), Null(), Alt(Date#(Trim([planned end date]), 'DD/MM/YYYY'), Date#(Trim([planned end date]), 'YYYY-MM-DD'))) AS [Baseline_End_Date],
    
    // --- 5. TEXT CLEANING ---
    [Background] AS [Background],
    If(Len(Trim([Background]))=0, Null(), Trim(Replace(Replace(Replace(ReplaceRegEx([Background], '<[^>]*>', ''), Chr(10), '|'), Chr(13), '|'), Chr(9), ' '))) AS [Background_Raw],
    If(Len(Trim([Audit Opinion Description]))=0, Null(), Trim(Replace(Replace(Replace(ReplaceRegEx([Audit Opinion Description], '<[^>]*>', ''), Chr(10), ' '), Chr(13), ' '), Chr(9), ' '))) AS [Audit_Opinion_Desc_Clean],
    If(Len(Trim([Executive Summary]))=0, Null(), Trim(Replace(Replace(Replace(ReplaceRegEx([Executive Summary], '<[^>]*>', ''), Chr(10), ' '), Chr(13), ' '), Chr(9), ' '))) AS [Executive_Summary_Clean],
    If(Len(Trim([Audit Opinion]))=0, Null(), Trim(Replace(Replace(Replace(ReplaceRegEx([Audit Opinion], '<[^>]*>', ''), Chr(10), ' '), Chr(13), ' '), Chr(9), ' '))) AS [Audit_Opinion_Clean],
    If(Len(Trim([Fieldwork Results]))=0, Null(), Trim(Replace(Replace(Replace(ReplaceRegEx([Fieldwork Results], '<[^>]*>', ''), Chr(10), ' '), Chr(13), ' '), Chr(9), ' '))) AS [Fieldwork_Results_Clean],
    If(Len(Trim([Purpose]))=0, Null(), Trim(Replace(Replace(Replace(Replace(Replace(ReplaceRegEx([Purpose], '<[^>]*>', ''), 'AUDIT REASON:', ''), 'AUDIT REASON :', ''), Chr(10), ' '), Chr(13), ' '), Chr(9), ' '))) AS [Audit_Purpose_Clean],
    
    // Division / Department clean
    If(Len(Trim([Division Department]))=0, Null(), 
        Trim(ReplaceRegEx(ReplaceRegEx(ReplaceRegEx(ReplaceRegEx(ReplaceRegEx(ReplaceRegEx([Division Department], '<[^>]*>', ''), ';\s*#\d+', ' / '), '\d*;#\d*', ' / '), ';', ' / '), '[/\s]+', ' / '), '^\s*/\s*|\s*/\s*$', ''))
    ) AS [Division_Dept_Clean],
    
    // --- 6. SIMPLE COUNTERS ---
    If(Trim([Finding identified])='Yes', 1, 0) AS [Flag_Finding_Identified]

WHERE NOT WildMatch([Audit No], 'COPY*', 'AD-TEST*', '*test*', '*BQ-T*', '*BQ-S*', '*2018-IA*', '*2019-IA*', '*2020-IA*', '*2021-IA*', '*2022-IA*', '*2023-IA*')
  AND NOT Exists(Audit_No_Blacklist, [Audit No]);
  
SELECT * FROM GetSheetValues
WITH PROPERTIES (
  spreadsheetKey='11k1yCFbkL4GlsldQKjVBiAFaIbBVQp0bty2kLmbk_vY',
