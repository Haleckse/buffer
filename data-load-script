/* ===========================================================================
   SECTION 04: EXTRACTING ACTIONS (DOC 4)
   Goal: We extract the actions created to fix the problems (findings). 
   We clean names, calculate delays, and organize the department codes.
   =========================================================================== */

LIB CONNECT TO 'GDRIVE_BQA DATA MODEL';

Doc_04_Actions:
// --- STEP 1: CALCULATING THE REAL DELAY ---
// We calculate exactly how many days early or late an action is
LOAD *,
    If([Flag_Action_Completed] = 1,
        Num([Action_Due_Date] - [Action_Completed_Date]), // If closed: Did we respect the deadline?
        Num([Action_Due_Date] - Today())                  // If still open: How late are we today?
    ) AS [Real_Days_Before_Due_Date];

// --- STEP 2: IMPORTING AND CLEANING DATA ---
LOAD Distinct
    // --- 1. THE BRIDGE KEYS ---
    Trim([Project ID]) AS [Project ID], 
    Trim([Finding id]) AS [Finding id], 
    Trim([Action id]) AS [Action id],   
    
    // 2. BASIC INFO & STATUS[cite: 1]
    // Cleaning action titles (Removing "Click here to" text blocks)
    Trim(
        Replace(Replace(Replace(Replace(Replace(Replace(Replace(Replace([Action title], 
        'CLICK HERE to ', ''), 
        'CLICK HERE ', ''), 
        'Click here to ', ''), 
        'Click here ', ''), 
        'CLIK HERE to ', ''),
        'Click HERE to ', ''),
        'Pincha aquí para añadir un ', ''),
        'Pincha aquí para ', '')
    ) AS [Action title],

    Trim([Action priority]) AS [Action priority],
    Trim([Action status]) AS [Action status],
    
    // Cleaning the Department Code (Removing trailing dots and 't.b.c')
    If(Len(Trim([Action Plan Leader Siglum]))=0 OR Lower(Trim([Action Plan Leader Siglum]))='t.b.c.',
        Null(),
        Trim(PurgeChar([Action Plan Leader Siglum], '.'))
    ) AS [APL_Siglum_Raw],
    
    // 3. CLEANING NAMES
    Upper(Trim(SubField(SubField([Action owner name], ' (', 1), ' - ', 1))) AS [Action_Owner_Name],
    Upper(Trim(SubField(SubField([commenter name], ' (', 1), ' - ', 1))) AS [Commenter_Name],
    ApplyMap('Map_Lead_Auditor', Upper(Trim(SubField(SubField([Lead auditor action], ' (', 1), ' - ', 1)))), Capitalize(Trim(SubField(SubField([Lead auditor action], ' (', 1), ' - ', 1))) AS [Lead_Auditor_Action],
    Trim([Action owner email]) AS [Action_Owner_Email],
    
    // --- 4. FIXING DATA ISSUES ---
    Trim([Action plan actual delivery date]) AS [Action_Affected_Sites], 
    
    // --- 5. THE ROOT CAUSE ---
    SubField(Replace(Replace(Trim([Root cause from PPS]), '  ', ' '), ';', ','), ',') AS [Root_Cause_PPS_Raw],
    
    // --- 6. CLEANING LONG TEXT ---
    If(Len(Trim([Action description]))=0, Null(), 
        Trim(Replace(Replace(Replace(PurgeChar([Action description], '<>'), Chr(10), ' '), Chr(13), ' '), Chr(9), ' '))
    ) AS [Action_Description_Clean],
    
    If(Len(Trim([comment content]))=0, Null(), 
        Trim(Replace(Replace(Replace(PurgeChar([comment content], '<>'), Chr(10), ' '), Chr(13), ' '), Chr(9), ' '))
    ) AS [Comment_Content_Clean],

   // --- 7. DATE FORMATTING ---
    If(WildMatch(Trim([Action due date]), '*1899*'), Null(), Alt(Date#(Trim([Action due date]), 'DD/MM/YYYY'), Date#(Trim([Action due date]), 'YYYY-MM-DD'), Date#(Trim([Action due date]), 'DD.MM.YYYY'))) AS [Action_Due_Date],
    If(WildMatch(Trim([Action completed date]), '*1899*'), Null(), Alt(Date#(Trim([Action completed date]), 'DD/MM/YYYY'), Date#(Trim([Action completed date]), 'YYYY-MM-DD'), Date#(Trim([Action completed date]), 'DD.MM.YYYY'))) AS [Action_Completed_Date],
    If(WildMatch(Trim([Action PPS due date]), '*1899*'), Null(), Alt(Date#(Trim([Action PPS due date]), 'DD/MM/YYYY'), Date#(Trim([Action PPS due date]), 'YYYY-MM-DD'), Date#(Trim([Action PPS due date]), 'DD.MM.YYYY'))) AS [Action_PPS_Due_Date],
    If(WildMatch(Trim([Action last update]), '*1899*'), Null(), Alt(Date#(Trim([Action last update]), 'DD/MM/YYYY'), Date#(Trim([Action last update]), 'YYYY-MM-DD'), Date#(Trim([Action last update]), 'DD.MM.YYYY'))) AS [Action_Last_Update],
    If(WildMatch(Trim([commenter date]), '*1899*'), Null(), Alt(Date#(Trim([commenter date]), 'DD/MM/YYYY'), Date#(Trim([commenter date]), 'YYYY-MM-DD'), Date#(Trim([commenter date]), 'DD.MM.YYYY'))) AS [Commenter_Date],
    If(WildMatch(Trim([created at]), '*1899*'), Null(), Alt(Date#(Trim([created at]), 'DD/MM/YYYY'), Date#(Trim([created at]), 'YYYY-MM-DD'), Date#(Trim([created at]), 'DD.MM.YYYY'))) AS [Action_Created_Date],
    
    // --- 8. SIMPLE COUNTERS (Yes/No flags) ---
    Num([Days before due date]) AS [Days_Before_Due_Date_MyCAT],
    If([Action completed]='Closed', 1, 0) AS [Flag_Action_Completed],
    If([Flag action late]='Overdue', 1, 0) AS [Flag_Action_Late]

//--- SECURITY FILTER ---
WHERE NOT WildMatch(ApplyMap('Map_Audit_No', Trim([Project ID]), 'COPY-ORPHAN'), 'COPY*', 'AD-TEST*', '*test*', '*BQ-T*', '*BQ-S*', '*2018-IA*', '*2019-IA*', '*2020-IA*', '*2021-IA*', '*2022-IA*', '*2023-IA*')
  AND NOT Exists(Audit_No_Blacklist, ApplyMap('Map_Audit_No', Trim([Project ID]), 'COPY-ORPHAN'));

SELECT * FROM GetSheetValues
WITH PROPERTIES (
  spreadsheetKey='1jmGundE2V1_PZVsJEHQQ4cZ6L55NvwfsR2PzWq4Ndbo', 
