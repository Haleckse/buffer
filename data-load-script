Doc_02_Objectives:
LOAD Distinct
// ... (la suite de ton code actuel reste identique)
    Trim([Project ID]) AS [Project ID], 
    Trim([Objective id]) AS [Objective id], 
    Trim([Objective reference]) AS [Objective reference], 
    [Audit No], 

    Trim([Objective name]) AS [Objective name], 
    Trim(ReplaceRegEx([Lead Auditor Objective], '<[^>]*>', '')) AS [Lead_Auditor_Objective_Raw],
    Trim(ReplaceRegEx([Co Auditor], '<[^>]*>', '')) AS [Co_Auditor_Objective_Raw],
    Trim(ReplaceRegEx([Audit Client], '<[^>]*>', '')) AS [Audit_Client_Objective_Raw],

    If(Len(Trim([Objective description]))=0, Null(), 
        Trim(Replace(Replace(Replace(ReplaceRegEx([Objective description], '<[^>]*>', ''), Chr(10), ' '), Chr(13), ' '), Chr(9), ' ')) 
    ) AS [Objective_Description_Clean]
RESIDENT Temp_Objectives_Raw

// --- SECURITY FILTER to ensure data quality ---

WHERE NOT (
    WildMatch([Audit No], 'COPY*', 'AD-TEST*', '*test*', '*BQ-T*', '*BQ-S*', '*2018-IA*', '*2019-IA*', '*2020-IA*', '*2021-IA*', '*2022-IA*', '*2023-IA*')
    OR WildMatch([Objective name], '*test*', '*COPY*', '*DUMMY*', '*don´t delete*')
) 
AND NOT Exists(Audit_No_Blacklist, [Audit No]);

// ===========================================================================
// --- 2. SEPARATING LISTS (BRIDGE TABLES) ---
// We separate Lead Auditors, Co-Auditors, and Clients into their own tables. 
// This prevents data duplication if one objective has multiple people assigned to it.
// ===========================================================================
Bridge_Obj_Lead_Auditor:
LOAD DISTINCT 
    Trim([Objective id]) AS [Objective id], 
    ApplyMap('Map_Lead_Auditor', Upper(Trim(Replace(Replace(Upper(Trim(SubField(SubField(SubField(Trim(ReplaceRegEx(ReplaceRegEx([Lead Auditor Objective], '<[^>]*>', ''), '\d+;#', '')), ';'), ' (', 1), ' - ', 1))), '(DS BQ AUDIT)', ''), 'DS BQ AUDIT', ''))), Capitalize(Trim(Replace(Replace(Upper(Trim(SubField(SubField(SubField(Trim(ReplaceRegEx(ReplaceRegEx([Lead Auditor Objective], '<[^>]*>', ''), '\d+;#', '')), ';'), ' (', 1), ' - ', 1))), '(DS BQ AUDIT)', ''), 'DS BQ AUDIT', '')))) AS [Lead_Auditor_Objective_Atomic]
RESIDENT Temp_Objectives_Raw
WHERE Len(Trim([Lead Auditor Objective]))>0 AND NOT WildMatch([Audit No], 'COPY*', 'AD-TEST*', '*test*');

