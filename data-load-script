    Trim([Lead auditor organisation]) AS [Lead_Auditor_Siglum_Final], 

    If(WildMatch(Upper(Trim([Airbus DS Business Lines])), '*CENTRAL*FUNC*', '*CENTRAL*', '*CF*'), 'CF',
    If(WildMatch(Upper(Trim([Airbus DS Business Lines])), '*MILITARY*', '*AIR*SYSTEMS*', '*AIP*', '*COMBAT*'), 'AIP',
    If(WildMatch(Upper(Trim([Airbus DS Business Lines])), '*SPACE*', '*SPS*'), 'SPS',
    If(WildMatch(Upper(Trim([Airbus DS Business Lines])), '*CONNECTED*', '*INTELLIGENCE*', '*CI*'), 'CI',
    Trim([Airbus DS Business Lines])
    )))) AS [Business_Unit_Atomic],

    
    If(Len(Trim([Reason Cancelation Postponed Delay]))=0 OR [Reason Cancelation Postponed Delay]='0', Null(), 
        Trim(Replace(Replace(Replace(PurgeChar([Reason Cancelation Postponed Delay], '<>'), Chr(10), ' '), Chr(13), ' '), Chr(9), ' '))
    ) AS [Reason_Delay_Cancel_Clean],

    Replace(Replace(Trim([Found in country]), ';', ','), '/', ',') AS [Hist_Country_Raw_String]

RESIDENT Temp_Hist_NC_Raw
WHERE Len(Trim([Audit No])) > 0 
  AND NOT Exists([Project ID], Trim([Audit No])) 
  AND NOT WildMatch([Audit No], 'COPY*', 'AD-TEST*', '*test*', '*DUMMY*');


// --- CHECKING DEADLINES (SLA) ---
// Did the auditor deliver the final report within 21 days after the audit ended?
Left Join (Hist_Projects)
LOAD 
    [Project ID],
    If(Num([Final_Report_Date] - [Audit_Planned_End_Date]) <= 21 AND Len(Trim([Final_Report_Date]))>0, 1, 0) AS [Flag_SLA_Report]
Resident Hist_Projects;


// --- EXTRACTING OLD PROBLEMS (FINDINGS) AND TASKS (ACTIONS) ---
Temp_Hist_NC:
LOAD
    Trim([Audit No]) AS [Project ID],
    Trim([Manual_Finding_Key]) AS [%Key_Finding_Action], 
    'GEN-' & Upper(Trim([Audit No])) AS [%Key_Objective],
    
    Lower(Trim([Classification])) AS [Raw_Severity_Historical],
    If(Len(Trim([Comment]))=0 OR [Comment]='0', Null(), Trim(Replace(Replace(Replace(PurgeChar([Comment], '<>'), Chr(10), ' '), Chr(13), ' '), Chr(9), ' '))) AS [Finding_Description_Clean],
    
    Upper(Trim([Action responsible])) AS [Action_Owner_Name],
    Upper(Trim([Action Responsible Siglum])) AS [APL_Siglum_Raw],
    If(Len(Trim([Action Closure Description]))=0 OR [Action Closure Description]='0', Null(), Trim(Replace(Replace(Replace(PurgeChar([Action Closure Description], '<>'), Chr(10), ' '), Chr(13), ' '), Chr(9), ' '))) AS [Comment_Content_Clean],
    
    Null() AS [Action_Description_Clean],
    
    If(WildMatch(Trim([Action Due Date]), '*1899*'), Null(), Alt(Date#(Trim([Action Due Date]), 'DD/MM/YYYY'), Date#(Trim([Action Due Date]), 'YYYY-MM-DD'))) AS [Action_Due_Date],
    If(WildMatch(Trim([Action Closure Date]), '*1899*'), Null(), Alt(Date#(Trim([Action Closure Date]), 'DD/MM/YYYY'), Date#(Trim([Action Closure Date]), 'YYYY-MM-DD'))) AS [Action_Completed_Date],
    
    If(Upper(Trim([Action Closed]))='TRUE' OR Trim([Action Closed])='1', 1, 0) AS [Flag_Action_Completed]
    
RESIDENT Temp_Hist_NC_Raw 
WHERE Len(Trim([Audit No])) > 0 
  AND NOT WildMatch([Audit No], 'COPY*', 'AD-TEST*', '*test*', '*DUMMY*'); 

DROP Table Temp_Hist_NC_Raw; 


Hist_Findings:
LOAD DISTINCT [%Key_Objective], [%Key_Finding_Action], [Finding_Description_Clean],
    If(WildMatch([Raw_Severity_Historical], '*major*', '*critical*'), 'Level 1 - Major',
    If(WildMatch([Raw_Severity_Historical], '*minor*'), 'Level 2 - Minor',
    'Level 3 - Improvement')) AS [Severity Group]
RESIDENT Temp_Hist_NC;

Hist_Actions:
LOAD DISTINCT [%Key_Finding_Action], [Action_Owner_Name], [APL_Siglum_Raw], [Action_Description_Clean], [Comment_Content_Clean], [Action_Due_Date], [Action_Completed_Date], [Flag_Action_Completed],
    If([Flag_Action_Completed] = 1, Num([Action_Due_Date] - [Action_Completed_Date]), Num([Action_Due_Date] - Today())) AS [Real_Days_Before_Due_Date],
    If([Action_Due_Date] < [Action_Completed_Date], 1, 0) AS [Flag_Action_Late]
RESIDENT Temp_Hist_NC;

DROP Table Temp_Hist_NC;


