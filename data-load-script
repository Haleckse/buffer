// --- 5. ATTRIBUTS ET DATES JALONS DEPUIS DOC 2 ---
LEFT JOIN (Doc_01_Projects)
LOAD Distinct
    Trim([Project ID]) AS [Project ID],
    Trim(Replace(Replace([Audit Title], 'CLICK HERE to ', ''), 'CLICK HERE ', '')) AS [Audit Title],
    Trim([Project Status]) AS [Project Status],
    Trim([Sub status]) AS [Sub status],
    Trim([Audit type]) AS [Audit type],
    Num(Trim([Audit plan year])) AS [Audit_Plan_Year],
    Trim([Audit Category]) AS [Audit_Category_Raw],
    Trim(ReplaceRegEx(Replace(Replace([Audit Function], ';', ' / '), ',', ' / '), '\s*/[/\s]*', ' / ')) AS [Audit_Function],
    
    // Dates jalons
    If(WildMatch(Trim([Audit planned start date]), '*1899*'), Null(), Alt(Date#(Trim([Audit planned start date]), 'DD/MM/YYYY'), Date#(Trim([Audit planned start date]), 'YYYY-MM-DD'))) AS [Audit_Planned_Start_Date],
    If(WildMatch(Trim([Audit planned end date]), '*1899*'), Null(), Alt(Date#(Trim([Audit planned end date]), 'DD/MM/YYYY'), Date#(Trim([Audit planned end date]), 'YYYY-MM-DD'))) AS [Audit_Planned_End_Date],
    If(WildMatch(Trim([Engagement Letter End Date]), '*1899*'), Null(), Alt(Date#(Trim([Engagement Letter End Date]), 'DD/MM/YYYY'), Date#(Trim([Engagement Letter End Date]), 'YYYY-MM-DD'))) AS [Engagement_Letter_Date],
    If(WildMatch(Trim([Opening Meeting End Date]), '*1899*'), Null(), Alt(Date#(Trim([Opening Meeting End Date]), 'DD/MM/YYYY'), Date#(Trim([Opening Meeting End Date]), 'YYYY-MM-DD'))) AS [Opening_Meeting_Date],
    If(WildMatch(Trim([Final Report End Date]), '*1899*'), Null(), Alt(Date#(Trim([Final Report End Date]), 'DD/MM/YYYY'), Date#(Trim([Final Report End Date]), 'YYYY-MM-DD'))) AS [Final_Report_Date],
    If(WildMatch(Trim([Closure Meeting End Date]), '*1899*'), Null(), Alt(Date#(Trim([Closure Meeting End Date]), 'DD/MM/YYYY'), Date#(Trim([Closure Meeting End Date]), 'YYYY-MM-DD'))) AS [Closure_Meeting_Date],

    // Lead Auditor
    ApplyMap('Map_Lead_Auditor', Upper(Trim(SubField(SubField(ReplaceRegEx([Lead Auditor Project], '<[^>]*>', ''), ' (', 1), ' - ', 1))), Capitalize(Trim(SubField(SubField(ReplaceRegEx([Lead Auditor Project], '<[^>]*>', ''), ' (', 1), ' - ', 1)))) AS [Lead_Auditor_Project],
    
    If(Len(Trim([Reason Cancelation Postponed Delay]))=0, Null(), Trim(Replace(Replace(Replace(ReplaceRegEx([Reason Cancelation Postponed Delay], '<[^>]*>', ''), Chr(10), ' '), Chr(13), ' '), Chr(9), ' '))) AS [Reason_Delay_Cancel_Clean],

    // Scope
    If(Len(Trim([Audit scope]))=0, Null(),
        Trim(
            Replace(Replace(Replace(Replace(Replace(Replace(Replace(Replace(
                ReplaceRegEx([Audit scope], '<[^>]*>', '')
            , 'AUDIT SCOPE:', '')
            , 'AUDIT SCOPE :', '')
            , 'AUDIT OBJECTIVE:', ' | OBJECTIVE:')
            , Chr(10), ' ')
            , Chr(13), ' ')
            , Chr(9), ' ')
            , ' ', ' ')
            , ' ', ' ')
        )
    ) AS [Audit_Scope_Clean]
RESIDENT Temp_Objectives_Raw;

