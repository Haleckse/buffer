    If(Num([AI_Cluster_Supervised_Confidence]) >= 0.85, '🎯 High Confidence (>=85%)',
        If(Num([AI_Cluster_Supervised_Confidence]) >= 0.60, '⚠️ Medium Confidence (60-84%)', '❓ Low Confidence (<60%)')
    )                                       AS [AI_Confidence_Bucket_Cluster]
RESIDENT Findings
WHERE Len(Trim([%Key_Finding_Action])) > 0;


