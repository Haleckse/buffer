// ===========================================================================
// --- 2. CLEANING THE MAIN TABLE ---
// ===========================================================================
NoConcatenate
External_Audits_Island:
LOAD DISTINCT
    // --- 1. MAIN IDENTIFIER (Removing hidden spaces and invisible characters) ---
    Trim(PurgeChar([ID], Chr(10)&Chr(13)&Chr(9)&Chr(160))) AS [Ext_ID],
    
    // --- 2. BASIC INFO (Replacing invisible text with proper blank 'Null' values) ---
    If(Len(Trim(PurgeChar([Programme LineSf], Chr(160)&Chr(9)&Chr(10)&Chr(13))))=0, Null(), Trim([Programme LineSf])) AS [Ext_Programme_Line],
    If(Len(Trim(PurgeChar([Site Country], Chr(160)&Chr(9)&Chr(10)&Chr(13))))=0, Null(), Trim([Site Country])) AS [Ext_Site_Country],
    If(Len(Trim(PurgeChar([Site name], Chr(160)&Chr(9)&Chr(10)&Chr(13))))=0, Null(), Trim([Site name])) AS [Ext_Site_Name],
    If(Len(Trim(PurgeChar([Auditor's name], Chr(160)&Chr(9)&Chr(10)&Chr(13))))=0, Null(), Trim([Auditor's name])) AS [Ext_Auditor_Name],
    If(Len(Trim(PurgeChar([auditee's siglum], Chr(160)&Chr(9)&Chr(10)&Chr(13))))=0, Null(), Trim([auditee's siglum])) AS [Ext_Auditee_Siglum],
    
    // --- 3. FIXING DATES (Handling different US and EU date formats safely) ---
    If(WildMatch(Trim([Date]), '*1899*') Or Len(Trim([Date])) = 0, Null(), 
        Alt(
            Date#(SubField(Trim([Date]), ' ', 1), 'DD/MM/YYYY'), // Format EU
            Date#(Trim([Date]), 'YYYY-MM-DD'),                  // Format US
            Date#(Trim([Date]), 'D/M/YYYY')                     // Sécurité
        )
    ) AS [Ext_Date],
    
    // --- 4. PROCESSES AND STANDARDS ---
    If(Len(Trim(PurgeChar([Audited Level 0 Process (Domain)], Chr(160)&Chr(9)&Chr(10)&Chr(13))))=0, Null(), Trim([Audited Level 0 Process (Domain)])) AS [Ext_Process_L0],
    
    // Conservé brut pour l'Audit Trail dans les tableaux simples (1 ligne par audit)
    If(Len(Trim(PurgeChar([Audited Level 1 Process], Chr(160)&Chr(9)&Chr(10)&Chr(13))))=0, Null(), Trim([Audited Level 1 Process])) AS [Ext_Process_L1_Raw],
    
    If(Len(Trim(PurgeChar([Classification of Finding], Chr(160)&Chr(9)&Chr(10)&Chr(13))))=0, Null(), Trim([Classification of Finding])) AS [Ext_Classification],
    If(Len(Trim(PurgeChar([Specific Standard], Chr(160)&Chr(9)&Chr(10)&Chr(13))))=0, Null(), Trim([Specific Standard])) AS [Ext_Specific_Standard],
    If(Len(Trim(PurgeChar([Standard §], Chr(160)&Chr(9)&Chr(10)&Chr(13))))=0, Null(), Trim([Standard §])) AS [Ext_Standard_Clause],
    If(Len(Trim(PurgeChar([Requirment Clause], Chr(160)&Chr(9)&Chr(10)&Chr(13))))=0, Null(), Trim([Requirment Clause])) AS [Ext_Requirement_Clause],
    
    // --- 5. LONG TEXT CLEANING (Removing HTML tags and line breaks) ---
    If(Len(Trim(PurgeChar([Subject of audit slot *refer to audit plan subject*], '<>'&Chr(160)&Chr(9)&Chr(10)&Chr(13))))=0, Null(),
        Trim(Replace(Replace(Replace(PurgeChar([Subject of audit slot *refer to audit plan subject*], '<>'), Chr(10), ' '), Chr(13), ' '), Chr(9), ' '))
    ) AS [Ext_Audit_Subject],
    
    If(Len(Trim(PurgeChar([Statement of finding], '<>'&Chr(160)&Chr(9)&Chr(10)&Chr(13))))=0, Null(),
        Trim(Replace(Replace(Replace(PurgeChar([Statement of finding], '<>'), Chr(10), ' '), Chr(13), ' '), Chr(9), ' '))
    ) AS [Ext_Statement_of_Finding],
    
    If(Len(Trim(PurgeChar([Objectives evidence], '<>'&Chr(160)&Chr(9)&Chr(10)&Chr(13))))=0, Null(),
        Trim(Replace(Replace(Replace(PurgeChar([Objectives evidence], '<>'), Chr(10), ' '), Chr(13), ' '), Chr(9), ' '))
    ) AS [Ext_Objectives_Evidence],

    // --- 6. ARTIFICIAL INTELLIGENCE DATA (Extra insights generated by AI) ---
    If(Len(Trim(PurgeChar([AI Systemic Risk], Chr(160)&Chr(9)&Chr(10)&Chr(13))))=0, Null(), Trim([AI Systemic Risk])) AS [Ext_AI_Systemic_Risk],
    Trim([AI Systemic Risk Confidence]) AS [Ext_AI_Systemic_Risk_Conf],
    If(Len(Trim(PurgeChar([AI Coherence Alert], Chr(160)&Chr(9)&Chr(10)&Chr(13))))=0, Null(), Trim([AI Coherence Alert])) AS [Ext_AI_Coherence_Alert],
    Trim([AI Coherence Alert Confidence]) AS [Ext_AI_Coherence_Alert_Conf],
    If(Len(Trim(PurgeChar([Cluster "Framed"], Chr(160)&Chr(9)&Chr(10)&Chr(13))))=0, Null(), Trim([Cluster "Framed"])) AS [Ext_AI_Cluster_Framed],
    Trim([Cluster "Framed" Confidence]) AS [Ext_AI_Cluster_Framed_Conf],
    If(Len(Trim(PurgeChar([Cluster Full unsupervised], Chr(160)&Chr(9)&Chr(10)&Chr(13))))=0, Null(), Trim([Cluster Full unsupervised])) AS [Ext_AI_Cluster_Unsupervised],
    Trim([Cluster Full unsupervised Confidence]) AS [Ext_AI_Cluster_Unsupervised_Conf],
    If(Len(Trim(PurgeChar([Ai cluster Supervised], Chr(160)&Chr(9)&Chr(10)&Chr(13))))=0, Null(), Trim([Ai cluster Supervised])) AS [Ext_AI_Cluster_Supervised],
    Trim([Ai cluster Supervised Confidence]) AS [Ext_AI_Cluster_Supervised_Conf],
    If(Len(Trim(PurgeChar([Historic systemic risk], Chr(160)&Chr(9)&Chr(10)&Chr(13))))=0, Null(), Trim([Historic systemic risk])) AS [Ext_Historic_Systemic_Risk]

RESIDENT Temp_External_Audits_Raw
WHERE Len(Trim(PurgeChar([ID], Chr(10)&Chr(13)&Chr(9)&Chr(160)))) > 2
