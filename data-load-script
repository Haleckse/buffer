    If(WildMatch(Raw_Hist_Site_Atomic, '*TLS*', '*TOULOUSE*'), 'TLS',
    Raw_Hist_Site_Atomic
    )))))))) AS [Affected_Site_Atomic]
;
LOAD DISTINCT 
    [Project ID],
    // Step 2: Split multiple site values into individual rows
    Trim(SubField(Comma_Hist_Site, ',')) AS Raw_Hist_Site_Atomic
;
LOAD DISTINCT 
    [Project ID],
    // Step 3: FIX - Replace all line breaks (Chr(10), Chr(13), \n, \r) and separators with commas
    Replace(Replace(Replace(Replace(Replace(Replace(Replace(Replace(Replace(Replace(
        Upper(Trim([Affected_Site_Raw]))
    , Chr(10), ','), Chr(13), ','), Chr(11), ','), '\n', ','), '\r', ','), ';', ','), '/', ','), ' AND ', ','), ' & ', ','), '+', ',') AS Comma_Hist_Site
RESIDENT Hist_Projects
