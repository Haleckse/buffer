END DATE: | @@@END DATE:
] (delimiter is '|');

// ===========================================================================
// --- 0.B - NAME FIXING DICTIONARY ---
// ===========================================================================
Map_Clean_Names:
MAPPING LOAD Trim(Dirty_Name) AS Dirty_Name, Trim(Clean_Name) AS Clean_Name INLINE [
Dirty_Name, Clean_Name
Montoya, Nora Virginia, Nora Montoya
Franco Ramirez, Antonio, Antonio Franco Ramirez
Gloria Vicente Vicente / Arturo García Perez, Arturo García Perez
García Perez, Arturo, Arturo García Perez
];

// ===========================================================================
// --- STEP 1: PREPARING THE TEXT (Applying the "@@@" Tags) ---
// ===========================================================================
Temp_Parsing:
LOAD DISTINCT [Project ID],
    MapSubstring('Map_Headers', 
        Replace(Replace(Replace(Replace(Replace(
            Upper([Background])
        , '<STRONG>', ''), '</STRONG>', ''), '<B>', ''), '</B>', ''), ' :', ':')
    ) & '@@@' AS [Background_Tagged]
RESIDENT Projects
WHERE Len(Trim([Project ID])) > 0 AND Len(Trim([Background])) > 0;

// ===========================================================================
// --- STEP 2: EXTRACTING THE DATA ---
// Now that the text has "@@@" before every section, we just tell the robot 
// to grab everything between two "@@@" tags.
// ===========================================================================
Temp_Extracted:
Temp_Extracted:
LOAD [Project ID],
    Trim(TextBetween([Background_Tagged], '@@@LEAD AUDITOR:', '@@@')) AS [Temp_Auditors_Block_Raw],
    Trim(TextBetween([Background_Tagged], '@@@AUDIT CLIENT:', '@@@')) AS [Background_Audit_Client_Raw],
    Trim(TextBetween([Background_Tagged], '@@@LEAD AUDITOR ORGANIZATION:', '@@@')) AS [Background_Lead_Auditor_Org_Raw],
    Trim(TextBetween([Background_Tagged], '@@@QUALITY MANAGEMENT DOMAIN ORGANIZATION:', '@@@')) AS [Background_Quality_Org_Raw],
    Trim(TextBetween([Background_Tagged], '@@@HOME COUNTRY:', '@@@')) AS [Background_Home_Country_Raw],
    Trim(TextBetween([Background_Tagged], '@@@PROGRAMME LINE:', '@@@')) AS [Background_Programme_Line_Raw],
    Trim(TextBetween([Background_Tagged], '@@@AFFECTED PRODUCT LINE:', '@@@')) AS [Background_Product_Line_Raw],
    Trim(TextBetween([Background_Tagged], '@@@AFFECTED PRODUCTS:', '@@@')) AS [Background_Affected_Products_Raw],
    Trim(TextBetween([Background_Tagged], '@@@ORGANISATION TO BE AUDITED:', '@@@')) AS [Background_Org_Audited_Raw],
    Trim(TextBetween([Background_Tagged], '@@@AFFECTED SITES:', '@@@')) AS [Background_Affected_Sites_Raw],
    Trim(TextBetween([Background_Tagged], '@@@BMS L0:', '@@@')) AS [Background_BMS_L0_Raw],
    Trim(TextBetween([Background_Tagged], '@@@BMS L1:', '@@@')) AS [Background_BMS_L1_Raw],
    Trim(TextBetween([Background_Tagged], '@@@BMS L2:', '@@@')) AS [Background_BMS_L2_Raw],
    Trim(TextBetween([Background_Tagged], '@@@BUSINESS UNIT:', '@@@')) AS [Background_Business_Unit_Raw],
    Trim(TextBetween([Background_Tagged], '@@@CERTIFICATION AFFECTED:', '@@@')) AS [Background_Certification_Raw],
    Trim(TextBetween([Background_Tagged], '@@@STANDARDS:', '@@@')) AS [Background_Standards_Raw],
    Trim(TextBetween([Background_Tagged], '@@@AUDITEE FOCAL POINTS:', '@@@')) AS [Background_Auditee_Focal_Points_Raw],
    Trim(TextBetween([Background_Tagged], '@@@RESTRICTIONS AUDIT DATE:', '@@@')) AS [Background_Restrictions_Date_Raw],
    Trim(TextBetween([Background_Tagged], '@@@COMMENTS:', '@@@')) AS [Background_Comments_Raw]
RESIDENT Temp_Parsing;

// ===========================================================================
// --- STEP 3: FINAL CLEANING (Removing HTML and messy characters) ---
// ===========================================================================
Temp_Cleaned:
LOAD [Project ID],
   // Cleaning the Auditors text block
    PurgeChar(
        Replace(Replace(Replace(Replace(Replace(Replace(Replace(
            ReplaceRegEx(ReplaceRegEx(ReplaceRegEx(ReplaceRegEx(
                Replace(Replace([Temp_Auditors_Block_Raw], ' AND ', ' / '), 'LA: ', '')
            , '&LT;[^&]*&GT;', '') 
            , '<[^>]*>', '')        
            , ';\s*#\d+', '')       
            , '\d*;#\d*', '')       
        , 'SPAN', '')
        , '/SPAN', '')
        , 'STYLE=', '')
        , 'TOQIC_TL2', '') 
        , '_adl', '')              
        , 'NONE', '')
        , 'N/A', '')
    , '<>"') AS [Temp_Auditors_Block_Cleaned], 

 // --- CLEANING THE AUDIT CLIENT INFO ---
    // 1. We remove HTML, then stop reading at the first ";" or "#"
    Trim(SubField(SubField(
        Replace(Replace(ReplaceRegEx([Background_Audit_Client_Raw], '<[^>]*>', ''), Chr(10), ' '), Chr(13), ' ')
    , ';', 1), '#', 1)) AS [Background_Audit_Client_Cleaned],
    
    // 2. We extract just the department code (Siglum) 
    Trim(SubField(ReplaceRegEx([Background_Audit_Client_Raw], '<[^>]*>', ''), ';', 2)) AS [Background_Audit_Client_Siglum],
   
    
    // Standardizing country codes (DE, FR, ES, UK, PT)
    If(Match(Upper(Trim(ReplaceRegEx([Background_Home_Country_Raw], '<[^>]*>', ''))), 'SPAIN', 'ESPAGNE', 'SP', 'ES'), 'SP',
    If(Match(Upper(Trim(ReplaceRegEx([Background_Home_Country_Raw], '<[^>]*>', ''))), 'GERMANY', 'ALLEMAGNE', 'GER', 'DE', 'GE'), 'GER',
    If(Match(Upper(Trim(ReplaceRegEx([Background_Home_Country_Raw], '<[^>]*>', ''))), 'FRANCE', 'FR'), 'FR',
    If(Match(Upper(Trim(ReplaceRegEx([Background_Home_Country_Raw], '<[^>]*>', ''))), 'PORTUGAL', 'PT', 'PO', 'POLAND'), 'PT',
    If(Match(Upper(Trim(ReplaceRegEx([Background_Home_Country_Raw], '<[^>]*>', ''))), 'UNITED KINGDOM', 'UK'), 'UK',
    Upper(Trim(ReplaceRegEx([Background_Home_Country_Raw], '<[^>]*>', '')))))))) AS [Background_Home_Country],

   // Simple cleaning (just removing HTML) for other fields
    Trim(ReplaceRegEx([Background_Lead_Auditor_Org_Raw], '<[^>]*>', '')) AS [Background_Lead_Auditor_Org],
    Trim(ReplaceRegEx([Background_Quality_Org_Raw], '<[^>]*>', '')) AS [Background_Quality_Org],
    Trim(ReplaceRegEx([Background_Org_Audited_Raw], '<[^>]*>', '')) AS [Background_Org_Audited],
    Trim(ReplaceRegEx([Background_Business_Unit_Raw], '<[^>]*>', '')) AS [Background_Business_Unit],
    Trim(ReplaceRegEx([Background_Certification_Raw], '<[^>]*>', '')) AS [Background_Certification],
    Trim(ReplaceRegEx(ReplaceRegEx(Replace(Replace(Replace(ReplaceRegEx([Background_Standards_Raw], '<[^>]*>', ' '), Chr(10), ' / '), Chr(13), ' / '), ';', ' / '), '\s*/[/\s]*', ' / '), '^\s*/\s*|\s*/\s*$', '')) AS [Background_Standards],   
    Trim(ReplaceRegEx([Background_Auditee_Focal_Points_Raw], '<[^>]*>', '')) AS [Background_Auditee_Focal_Points],
    Trim(ReplaceRegEx([Background_Restrictions_Date_Raw], '<[^>]*>', '')) AS [Background_Restrictions_Date],
    Trim(Replace(ReplaceRegEx([Background_Comments_Raw], '<[^>]*>', ''), '//', '')) AS [Background_Comments],

    // =======================================================================
    // 🟢 EXTRACTING PROGRAMME & PRODUCT LINE (Taking the text after the "-")
    // =======================================================================
    Trim(SubField(
        Trim(ReplaceRegEx(ReplaceRegEx(ReplaceRegEx(Replace(Replace(Replace(ReplaceRegEx([Background_Programme_Line_Raw], '<[^>]*>', ''), '#', ''), ';', ' / '), ',', ' / '), '\b\d+\b', ''), '\s*/[/\s]*', ' / '), '^\s*/\s*|\s*/\s*$', ''))
    , ' - ', -1)) AS [Background_Programme_Line],

    Trim(SubField(
        Trim(ReplaceRegEx(ReplaceRegEx(ReplaceRegEx(Replace(Replace(Replace(ReplaceRegEx([Background_Product_Line_Raw], '<[^>]*>', ''), '#', ''), ';', ' / '), ',', ' / '), '\b\d+\b', ''), '\s*/[/\s]*', ' / '), '^\s*/\s*|\s*/\s*$', ''))
    , ' - ', -1)) AS [Background_Product_Line],

    // --- CLEANING MULTIPLE ITEMS (Replacing commas and semicolons with slashes) ---
    Trim(ReplaceRegEx(ReplaceRegEx(Replace(ReplaceRegEx(Replace(Replace(Replace(Replace(ReplaceRegEx([Background_Affected_Products_Raw], '<[^>]*>', ''), 'C-', 'C_'), '#', ''), ';', ' / '), ',', ' / '), '\b\d+\b', ''), 'C_', 'C-'), '\s*/[/\s]*', ' / '), '^\s*/\s*|\s*/\s*$', '')) AS [Background_Affected_Products],
    Trim(ReplaceRegEx(ReplaceRegEx(ReplaceRegEx(Replace(Replace(Replace(ReplaceRegEx([Background_Affected_Sites_Raw], '<[^>]*>', ''), '#', ''), ';', ' / '), ',', ' / '), '\b\d+\b', ''), '\s*/[/\s]*', ' / '), '^\s*/\s*|\s*/\s*$', '')) AS [Background_Affected_Sites],
    Trim(ReplaceRegEx(ReplaceRegEx(ReplaceRegEx(Replace(Replace(Replace(ReplaceRegEx([Background_BMS_L0_Raw], '<[^>]*>', ''), '#', ''), ';', ' / '), ',', ' / '), '\b\d+\b', ''), '\s*/[/\s]*', ' / '), '^\s*/\s*|\s*/\s*$', '')) AS [Background_BMS_L0],
    Trim(ReplaceRegEx(ReplaceRegEx(ReplaceRegEx(Replace(Replace(Replace(ReplaceRegEx([Background_BMS_L1_Raw], '<[^>]*>', ''), '#', ''), ';', ' / '), ',', ' / '), '\b\d+\b', ''), '\s*/[/\s]*', ' / '), '^\s*/\s*|\s*/\s*$', '')) AS [Background_BMS_L1],
    Trim(ReplaceRegEx(ReplaceRegEx(ReplaceRegEx(Replace(Replace(Replace(ReplaceRegEx([Background_BMS_L2_Raw], '<[^>]*>', ''), '#', ''), ';', ' / '), ',', ' / '), '\b\d+\b', ''), '\s*/[/\s]*', ' / '), '^\s*/\s*|\s*/\s*$', '')) AS [Background_BMS_L2],

  // =======================================================================
    // 🟢 DEDUCING THE BUSINESS UNIT (Looking at multiple fields to guess correctly)
    // =======================================================================
    If(WildMatch(Upper([Background_Business_Unit_Raw] & ' ' & [Background_Programme_Line_Raw] & ' ' & [Background_Product_Line_Raw]), 
        '*AIP*', '*AIR*POWER*', '*MIA*', '*MILITARY*', '*A400M*', '*M&L*', '*COMBAT*', '*MRO*', '*EURODRONE*', '*MRTT*'), 'AIP',
        
        If(WildMatch(Upper([Background_Business_Unit_Raw] & ' ' & [Background_Programme_Line_Raw] & ' ' & [Background_Product_Line_Raw]), 
            '*SPS*', '*SPACE*', '*EARTH OBSERVATION*', '*TELECOMMUNICATION*', '*NAVIGATION*'), 'SPS',
            
            If(WildMatch(Upper([Background_Business_Unit_Raw] & ' ' & [Background_Programme_Line_Raw] & ' ' & [Background_Product_Line_Raw]), 
                '*CF*', '*CENTRAL*'), 'CF',
                
                If(WildMatch(Upper([Background_Business_Unit_Raw] & ' ' & [Background_Programme_Line_Raw] & ' ' & [Background_Product_Line_Raw]), 
                    '* CI *', 'CI *', '* CI', 'CI-', '*CONNECTED*', '*CYBER*', '*INTELLIGENCE*', '*SECURITY SOLUTIONS*', '*SECURE LAND*', '*SPECIAL SECURITY*', '*MULTI-DOMAIN*', '*MULTI DOMAIN*', '*GROUND SYSTEM*', '*DEFENCE DIGITAL*'), 'CI',
                    
                    If(WildMatch(Upper([Background_Business_Unit_Raw] & ' ' & [Background_Programme_Line_Raw] & ' ' & [Background_Product_Line_Raw]), 
                        '* PL *', 'PL *', '* PL', 'PL'), 'PL',
                        
                        Null() 
                    )
                )
            )
        )
    ) AS [Business_Unit_Atomic]

RESIDENT Temp_Extracted;  

// ===========================================================================
// --- STEP 4: ADDING EVERYTHING TO THE MAIN PROJECTS TABLE ---
// ============================================================================
LEFT JOIN (Projects)
LOAD [Project ID],
    // --- FORMATTING LEAD AUDITOR NAMES --
    If(Len(Trim(PurgeChar(SubField([Temp_Auditors_Block_Cleaned], '/', 1), '/'))) = 0, Null(), 
        ApplyMap('Map_Clean_Names', Capitalize(Trim(PurgeChar(SubField([Temp_Auditors_Block_Cleaned], '/', 1), '/'))), Capitalize(Trim(PurgeChar(SubField([Temp_Auditors_Block_Cleaned], '/', 1), '/'))))
    ) AS [Background_Lead_Auditor_Extract],
    
    If(Len(Trim(PurgeChar(SubField([Temp_Auditors_Block_Cleaned], '/', 1), '/'))) = 0, Null(), 
        ApplyMap('Map_Clean_Names', Capitalize(Trim(PurgeChar(SubField([Temp_Auditors_Block_Cleaned], '/', 1), '/'))), Capitalize(Trim(PurgeChar(SubField([Temp_Auditors_Block_Cleaned], '/', 1), '/'))))
    ) AS [B_lead_auditor],
    
   // --- FORMATTING CO-AUDITOR NAMES ---
    If(Len(Trim(PurgeChar(SubField([Temp_Auditors_Block_Cleaned], '/', 2), '/'))) = 0 OR Trim(SubField([Temp_Auditors_Block_Cleaned], '/', 2)) = 'NONE',
        If(Len(Trim(PurgeChar(SubField([Temp_Auditors_Block_Cleaned], '/', 3), '/'))) = 0 OR Trim(SubField([Temp_Auditors_Block_Cleaned], '/', 3)) = 'NONE', Null(), Capitalize(Trim(PurgeChar(SubField([Temp_Auditors_Block_Cleaned], '/', 3), '/'))) & ' (S)'),
        If(Len(Trim(PurgeChar(SubField([Temp_Auditors_Block_Cleaned], '/', 3), '/'))) = 0 OR Trim(SubField([Temp_Auditors_Block_Cleaned], '/', 3)) = 'NONE', Capitalize(Trim(PurgeChar(SubField([Temp_Auditors_Block_Cleaned], '/', 2), '/'))), Capitalize(Trim(PurgeChar(SubField([Temp_Auditors_Block_Cleaned], '/', 2), '/'))) & ' / ' & Capitalize(Trim(PurgeChar(SubField([Temp_Auditors_Block_Cleaned], '/', 3), '/'))) & ' (S)')
    ) AS [Background_Co_Auditor_Extract],
    
    If(Len(Trim(PurgeChar(SubField([Temp_Auditors_Block_Cleaned], '/', 2), '/'))) = 0 OR Trim(SubField([Temp_Auditors_Block_Cleaned], '/', 2)) = 'NONE',
        If(Len(Trim(PurgeChar(SubField([Temp_Auditors_Block_Cleaned], '/', 3), '/'))) = 0 OR Trim(SubField([Temp_Auditors_Block_Cleaned], '/', 3)) = 'NONE', Null(), Capitalize(Trim(PurgeChar(SubField([Temp_Auditors_Block_Cleaned], '/', 3), '/'))) & ' (S)'),
        If(Len(Trim(PurgeChar(SubField([Temp_Auditors_Block_Cleaned], '/', 3), '/'))) = 0 OR Trim(SubField([Temp_Auditors_Block_Cleaned], '/', 3)) = 'NONE', Capitalize(Trim(PurgeChar(SubField([Temp_Auditors_Block_Cleaned], '/', 2), '/'))), Capitalize(Trim(PurgeChar(SubField([Temp_Auditors_Block_Cleaned], '/', 2), '/'))) & ' / ' & Capitalize(Trim(PurgeChar(SubField([Temp_Auditors_Block_Cleaned], '/', 3), '/'))) & ' (S)')
    ) AS [B_co_auditor],
    
    // --- FORMATTING AUDIT CLIENT ---
    ApplyMap('Map_Clean_Names', Capitalize([Background_Audit_Client_Cleaned]), Capitalize([Background_Audit_Client_Cleaned])) AS [Background_Audit_Client], 
    [Background_Audit_Client_Siglum], 
    
    // Transferring the rest of the cleaned data
    [Background_Home_Country],
    [Background_Lead_Auditor_Org],
    [Background_Quality_Org],
    [Background_Org_Audited],
    [Background_Business_Unit],
    [Background_Certification],
    [Background_Standards],
    [Background_Auditee_Focal_Points],
    [Background_Restrictions_Date],
    [Background_Comments],
    [Background_Programme_Line],
    [Background_Product_Line],
    [Background_Affected_Products],
    [Background_Affected_Sites],
    [Background_BMS_L0],
    [Background_BMS_L1],
    [Background_BMS_L2],
    [Business_Unit_Atomic]
RESIDENT Temp_Cleaned;

// ===========================================================================
// --- STEP 5: MEMORY CLEANUP ---
// ===========================================================================
DROP TABLE Temp_Parsing;
DROP TABLE Temp_Extracted;
DROP TABLE Temp_Cleaned;
DROP Field [Background] FROM Projects;

TRACE [Section 10] Parsing completed securely with Dual Dictionary.;

/* ===========================================================================
   SECTION 13: CREATING THE CALENDARS (MASTER CALENDAR)
   Goal: We build two separate calendars (one for Audits, one for Actions) 
   so the dashboard can easily filter data by Year, Month, or Quarter.
   We make sure the timeline starts at least in 2016 and goes up to today.
   =========================================================================== */


// ===========================================================================
// --- 1. THE AUDIT CALENDAR ---
// We link this calendar to the [Audit_Planned_Start_Date].
// ===========================================================================

// Step 1: Find the oldest and newest dates in our projects

Temp_MinMax_Audit:
LOAD 
    Min(Alt([Audit_Planned_Start_Date], [Final_Report_Date])) AS RawMinAuditDate, 
    Max(Alt([Audit_Planned_End_Date], [Final_Report_Date], [Audit_Planned_Start_Date])) AS RawMaxAuditDate
RESIDENT Projects;


// Step 2: Set the boundaries
// Start Date: January 1st, 2016 (or earlier if an older audit exists)
LET vMinAuditDate = Num(RangeMin(MakeDate(2016, 1, 1), Alt(Peek('RawMinAuditDate', 0, 'Temp_MinMax_Audit'), MakeDate(2016, 1, 1))));

// End Date: The end of the current year (or later if future audits exist)
LET vMaxAuditDate = Num(RangeMax(YearEnd(Today()), Alt(Peek('RawMaxAuditDate', 0, 'Temp_MinMax_Audit'), Today())));

DROP TABLE Temp_MinMax_Audit;

// Step 3: Generate every single day between the Start Date and End Date
Temp_Dates_Audit:
LOAD 
    Date($(vMinAuditDate) + IterNo() - 1) AS TempAuditDate
AUTOGENERATE 1
WHILE $(vMinAuditDate) + IterNo() - 1 <= $(vMaxAuditDate);

// Step 4: Create useful time filters (Year, Month, Quarter)
Audit_Calendar:
LOAD 
    TempAuditDate AS [Audit_Planned_Start_Date], // Connection to the Projects table
    Year(TempAuditDate) AS [Audit Year],
    Month(TempAuditDate) AS [Audit Month],
    'Q' & Ceil(Month(TempAuditDate)/3) AS [Audit Quarter],
    Week(TempAuditDate) AS [Audit Week],
    Date(MonthStart(TempAuditDate), 'YYYY-MM') AS [Audit Year-Month]
RESIDENT Temp_Dates_Audit;

DROP TABLE Temp_Dates_Audit;


// ===========================================================================
// --- 2. THE ACTION CALENDAR ---
// We link this calendar to the [Action_Due_Date]. 
// The steps are exactly the same as above.
// ===========================================================================

// Step 1: Find the oldest and newest due dates
Temp_MinMax_Action:
LOAD 
    Min([Action_Due_Date]) AS RawMinActionDate, 
    Max([Action_Due_Date]) AS RawMaxActionDate
RESIDENT Actions
WHERE Not IsNull([Action_Due_Date]);

// Step 2: Set the boundaries (starting at least in 2016)
LET vMinActionDate = Num(RangeMin(MakeDate(2016, 1, 1), Alt(Peek('RawMinActionDate', 0, 'Temp_MinMax_Action'), MakeDate(2016, 1, 1))));
LET vMaxActionDate = Num(RangeMax(YearEnd(Today()), Alt(Peek('RawMaxActionDate', 0, 'Temp_MinMax_Action'), Today())));

DROP TABLE Temp_MinMax_Action;

// Step 3: Generate all the days

Temp_Dates_Action:
LOAD 
    Date($(vMinActionDate) + IterNo() - 1) AS TempActionDate
AUTOGENERATE 1
WHILE $(vMinActionDate) + IterNo() - 1 <= $(vMaxActionDate);

// Step 4: Create the filter
Action_Calendar:
LOAD 
    TempActionDate AS [Action_Due_Date], // 🔗 Liaison vers Actions
    Year(TempActionDate) AS [Action Due Year],
    Month(TempActionDate) AS [Action Due Month],
    'Q' & Ceil(Month(TempActionDate)/3) AS [Action Due Quarter],
    Week(TempActionDate) AS [Action Due Week],
    Date(MonthStart(TempActionDate), 'YYYY-MM') AS [Action Due Year-Month]
RESIDENT Temp_Dates_Action;

DROP TABLE Temp_Dates_Action;

/* ===========================================================================
   SECTION 14: FINAL MAPPING AND DATA QUALITY
   Goal: We bring in the manual corrections (Doc 7) and do a final sweep 
   to check the quality of our data. We apply the latest business rules 
   and standardize everything across all dashboards.
   =========================================================================== */
   
// ===========================================================================
// --- 1. LOADING MANUAL CORRECTIONS (DOC 7) ---
// We link the manual corrections table to our main Projects table.
// ===========================================================================
LEFT JOIN (Projects)
LOAD * FROM [lib://AttachedFiles/Doc_7_Audit_Corrections.qvd] (qvd);

// ===========================================================================
// --- 2. THE FINAL LOGIC SWEEP ---
// We overwrite the messy original data with our cleaned, standardized data.
// ===========================================================================

Final_Logic:
LEFT JOIN (Projects)

LOAD
    [Project ID],
    // Applying the cleaned versions of names, countries, and domains
    [Background_Audit_Client] AS [Audit_Client_Clean],
    [Background_Home_Country] AS [Extracted_Country],
    [DQ_Country_Check_Status],
    [DQ_Domain_Check_Status],
    [Domain_Final],
    [Programme_Line_Final],
    [Product_Line_Clean], 
    
    [SLA_Reference_Date], 
    
    // --- SLA CALCULATION (Service Level Agreement) ---
    // Rule: The Final Report must be delivered within 21 days after the audit ends.
    If(IsNull([Final_Report_Date]) Or IsNull([SLA_Reference_Date]), 0,
        If([Final_Report_Date] <= [SLA_Reference_Date] + 21, 1, 0)
    ) AS [Flag_SLA_Report],

    // Adding a visual traffic light system for the SLA status
    If(Len(Trim([Final_Report_Date])) = 0, '⚪ No data',
        If([Final_Report_Date] <= [SLA_Reference_Date] + 21, '🟢 In time', '🔴 Overdue')
    ) AS [SLA_Status_Visual],
    
    // --- FINAL CLEANING OF AUDITOR NAMES ---
    // Removing the word "Trainee" and translating the name using the dictionary
    ApplyMap('Map_Lead_Auditor', 
        Upper(Trim(If(Left(Trim([Temp_Lead_Auditor]), 1) = '/', Trim(Mid(Trim([Temp_Lead_Auditor]), 2)), If(WildMatch(Upper(Trim([Temp_Lead_Auditor])), 'T1Q*', 'TAO*', 'TOQ*', 'TDB*', 'TMC*') AND Len(Trim([Temp_Lead_Auditor])) <= 8, '-', Trim(SubField(Replace(Replace(Replace(Upper([Temp_Lead_Auditor]), 'SUPERVISING', ''), 'SUPERVISOR', ''), 'AS TRAINEE', ''), ' - ', 1)))))),
        Capitalize(Trim(If(Left(Trim([Temp_Lead_Auditor]), 1) = '/', Trim(Mid(Trim([Temp_Lead_Auditor]), 2)), If(WildMatch(Upper(Trim([Temp_Lead_Auditor])), 'T1Q*', 'TAO*', 'TOQ*', 'TDB*', 'TMC*') AND Len(Trim([Temp_Lead_Auditor])) <= 8, '-', Trim(SubField(Replace(Replace(Replace(Upper([Temp_Lead_Auditor]), 'SUPERVISING', ''), 'SUPERVISOR', ''), 'AS TRAINEE', ''), ' - ', 1))))))
    ) AS [Lead_Auditor_Final],

    If(Left(Trim([Temp_Co_Auditor]), 1) = '/', Trim(Mid(Trim([Temp_Co_Auditor]), 2)), Trim([Temp_Co_Auditor])) AS [Co_Auditor_Final],
   
   // Fixing a specific known error in a department code
    If(Match(Upper(Trim([Background_Audit_Client_Siglum])), 'TAOQSP1AOQSP1', 'AOQSP1AOQSP1'), 'TAOQSP1', [Background_Audit_Client_Siglum]) AS [Audit_Client_Siglum_Clean];

// --- TEMPORARY LOAD FOR CALCULATIONS ---
LOAD DISTINCT
    [Project ID],
    [Background_Audit_Client],
    [Background_Audit_Client_Siglum],
    [Background_Home_Country],
    [Final_Report_Date], 
    
    // Determining the true Audit End Date for the SLA calculation.
    If(Len(Trim([Audit_Planned_End_Date])) > 0 And [Audit_Planned_End_Date] <> [Baseline_End_Date], 
        [Audit_Planned_End_Date], 
        [Baseline_End_Date]
    ) AS [SLA_Reference_Date],
    
    // Data Quality Checks: Did the manual correction match the original data?
    If(Len(Trim([Country_Cor])) > 0, If(Trim(Upper([Country_Cor])) = Trim(Upper([Background_Home_Country])), '🟢 Match', '🔴 Mismatch'), '⚪ No correction') AS [DQ_Country_Check_Status],
    // The Rule: If a manual correction exists, it ALWAYS wins.
    If(Len(Trim([Process_Domain_Cor])) > 0, If(Trim(Upper([Process_Domain_Cor])) = Trim(Upper([Audit_Function])), '🟢 Match', '🔴 Mismatch'), '⚪ No correction') AS [DQ_Domain_Check_Status],
    If(Len(Trim([Process_Domain_Cor])) > 0, Trim([Process_Domain_Cor]), Trim([Audit_Function])) AS [Domain_Final],
   Coalesce(
    If(Len(Trim([Affected_ProgrammeLine_Cor])) > 0 AND [Affected_ProgrammeLine_Cor] <> '-', Trim([Affected_ProgrammeLine_Cor])),
    If(Len(Trim([Business_Unit_Atomic])) > 0 AND [Business_Unit_Atomic] <> '-', Trim([Business_Unit_Atomic])),
    If(Len(Trim([Background_Programme_Line])) > 0 AND [Background_Programme_Line] <> '-', Trim([Background_Programme_Line])),
    'Other'
) AS [Programme_Line_Final],

    If(Len(Trim([Affected_ProductLine_Cor])) > 0, Trim([Affected_ProductLine_Cor]), Trim([Background_Affected_Products])) AS [Product_Line_Clean],


    // --- THE LEAD AUDITOR ENGINE ---
    // A complex formula to extract the absolute purest version of the Lead Auditor's name.
    If(Len(Trim([Co_Auditor_Raw])) > 3 AND Index(Upper(PurgeChar([Background_Lead_Auditor_Extract], ' ,.')), Upper(PurgeChar([Co_Auditor_Raw], ' ,.'))) > 0,
        Trim(Replace(PurgeChar([Background_Lead_Auditor_Extract], ','), PurgeChar([Co_Auditor_Raw], ','), '')),
        
        If(Match(Upper(Trim(
            If(Len(Trim([Background_Lead_Auditor_Extract])) > 0, [Background_Lead_Auditor_Extract], 
            If(Len(Trim([Lead_Auditor_Project])) > 0 AND [Lead_Auditor_Project] <> '-', [Lead_Auditor_Project], 
            If(Len(Trim([Background_Lead_Auditor_Org])) > 3 AND NOT Match(Upper(Trim([Background_Lead_Auditor_Org])), '0', 'NONE', 'TOQIC_TL2', 'TOQSP', 'TOQIC'), [Background_Lead_Auditor_Org], '-')))
        )), '0', 'NONE', 'N/A', '-', '(S)', '(S)') 
        Or Len(Trim(
            If(Len(Trim([Background_Lead_Auditor_Extract])) > 0, [Background_Lead_Auditor_Extract], 
            If(Len(Trim([Lead_Auditor_Project])) > 0 AND [Lead_Auditor_Project] <> '-', [Lead_Auditor_Project], 
            If(Len(Trim([Background_Lead_Auditor_Org])) > 3 AND NOT Match(Upper(Trim([Background_Lead_Auditor_Org])), '0', 'NONE', 'TOQIC_TL2', 'TOQSP', 'TOQIC'), [Background_Lead_Auditor_Org], '-')))
        )) = 0, 
        '-', 
        Trim(Replace(Replace(Replace(Replace(Replace(Replace(ReplaceRegEx(ReplaceRegEx(
            If(Len(Trim([Background_Lead_Auditor_Extract])) > 0, [Background_Lead_Auditor_Extract], 
            If(Len(Trim([Lead_Auditor_Project])) > 0 AND [Lead_Auditor_Project] <> '-', [Lead_Auditor_Project], 
            If(Len(Trim([Background_Lead_Auditor_Org])) > 3 AND NOT Match(Upper(Trim([Background_Lead_Auditor_Org])), '0', 'NONE', 'TOQIC_TL2', 'TOQSP', 'TOQIC'), [Background_Lead_Auditor_Org], '-')))
        , ';\s*#\d+', '') , '\d*;#\d*', '') , '_adl', '') , Chr(160), ' ') , ', ', ' ') , ',', ' ') , ';', ' / ') , '  ', ' / '))
        ) 
    ) AS [Temp_Lead_Auditor],

    // --- THE CO-AUDITOR ENGINE ---
    If(Match(Upper(Trim(If(Len(Trim([Background_Co_Auditor_Extract])) > 0, [Background_Co_Auditor_Extract], [Co_Auditor_Raw]))), '0', 'NONE', 'N/A', '-', '(S)', '(S)', 'S') 
       Or Len(Trim(If(Len(Trim([Background_Co_Auditor_Extract])) > 0, [Background_Co_Auditor_Extract], [Co_Auditor_Raw]))) = 0
       Or Trim(If(Len(Trim([Background_Co_Auditor_Extract])) > 0, [Background_Co_Auditor_Extract], [Co_Auditor_Raw])) = '(S)'
       Or Trim(If(Len(Trim([Background_Co_Auditor_Extract])) > 0, [Background_Co_Auditor_Extract], [Co_Auditor_Raw])) = '(S)', 
        '-', 
        Trim(Replace(Replace(Replace(Replace(Replace(Replace(Replace(Replace(Replace(ReplaceRegEx(ReplaceRegEx(
           If(Len(Trim([Background_Co_Auditor_Extract])) > 0, [Background_Co_Auditor_Extract], [Co_Auditor_Raw])
        , ';\s*#\d+', '') , '\d*;#\d*', '') , '_adl', '') , Chr(160), ' ') , 'AS A TRAINEE', '(As a Trainee)') , 'AS A TRAINEE', '(As a Trainee)') , 'AS A TRAINEE', '(As a Trainee)') , ', ', ' ') , ',', ' ') , ';', ' / ') , '  ', ' / '))
    ) AS [Temp_Co_Auditor]
RESIDENT Projects
WHERE [Project ID] <> '82664';

// ===========================================================================
// --- 3. FINAL BRIDGE TABLES (Creating filter lists) ---
// ===========================================================================

Bridge_Project_Lead_Auditor:
LOAD DISTINCT 
    [Project ID],
    [Lead_Auditor_Project_Atomic],
    If(Len(Trim([Lead_Auditor_Project_Context])) = 0, 'OFFICIAL', [Lead_Auditor_Project_Context]) AS [Lead_Auditor_Project_Context]
WHERE Len(Trim([Lead_Auditor_Project_Atomic])) > 2  
  AND NOT WildMatch([Lead_Auditor_Project_Atomic], '*TBA*', '*THEORY*', '*CAPGEMINI*', '*SUPERVISOR*', '*TRAINEE*', '*COAUDITOR*', 'AS *', 'CO-AUDITOR*', 'LEAD AUDITOR*');

LOAD DISTINCT 
    [Project ID],
    ApplyMap('Map_Lead_Auditor', Upper(Trim(SubField([Standardized_String_Lead], '|', 1))), Capitalize(Trim(SubField([Standardized_String_Lead], '|', 1)))) AS [Lead_Auditor_Project_Atomic],
    If(Index([Standardized_String_Lead], '|') > 0, 
        Trim(Replace(Replace(Mid([Standardized_String_Lead], Index([Standardized_String_Lead], '|') + 1), '|', ' - '), ')', '')), 
        ''
    ) AS [Lead_Auditor_Project_Context]
;
LOAD DISTINCT 
    [Project ID],
    Replace(Replace(Replace(Replace(Replace(
        Replace(Replace(Replace(Upper(Trim(SubField([Lead_Auditor_Final], '/'))), 
        'CO-AUDITOR:', ''), 'CO AUDITOR:', ''), 'LEAD AUDITOR:', '')
    , ' - ', '|'), 
    ' AS ', '|'), 
    '[', '|'), 
    ']', ''), 
    '(', '|') AS [Standardized_String_Lead]
RESIDENT Projects
WHERE [Lead_Auditor_Final] <> '-' AND [Project ID] <> '82664'; 



// ===========================================================================
// --- 4. CLEANING SITE NAMES (DOUBLE TRONÇONNEUSE) ---
// ===========================================================================

// Step 1: Extreme Cleaning - Destroys invisible spaces, protects dashes, turns punctuation to commas
Temp_Bg_Sites_Clean:
LOAD 
    [Project ID],
    Upper(Trim(Replace(Replace(Replace(Replace(Replace(Replace(Replace(Replace(Replace(Replace(Replace(Replace(Replace(Replace(Replace(Replace(Replace([Background_Affected_Sites], Chr(160), ' '), '   ', ' '), '  ', ' '), Chr(10), ','), Chr(13), ','), '\n', ','), '\r', ','), '(', ','), ')', ','), ':', ','), ' - ', ','), ';', ','), '/', ','), '|', ','), '&', ','), '+', ','), ' AND ', ','))) AS Raw_Site_Prepared
RESIDENT Projects
WHERE Len(Trim([Background_Affected_Sites])) > 0 
  AND NOT Match(Upper(Trim([Background_Affected_Sites])), '-', 'N/A', '/N/A', 'NONE', 'NULL', 'NA', '0');

// Step 2: Cutting 1
NoConcatenate
Temp_Bg_Sites_Split:
LOAD DISTINCT 
    [Project ID],
    Trim(SubField(Raw_Site_Prepared, ',')) AS Raw_Site_Atomic
RESIDENT Temp_Bg_Sites_Clean;

// Step 3: Apply the Dictionary
NoConcatenate
Temp_Bg_Sites_Mapped:
LOAD DISTINCT
    [Project ID],
    ApplyMap('Map_Master_Sites', Upper(Trim(Raw_Site_Atomic)), Upper(Trim(Raw_Site_Atomic))) AS Mapped_Site
RESIDENT Temp_Bg_Sites_Split
WHERE Len(Trim(Raw_Site_Atomic)) > 1;

// Step 4: Cutting 2 & second CLEAN (Upper, Trim, PurgeChar)
NoConcatenate
Bridge_Project_Sites:
LOAD DISTINCT 
    [Project ID], 
    Upper(Trim(PurgeChar(SubField(Mapped_Site, ','), Chr(160)&Chr(9)&Chr(10)&Chr(13)))) AS [Affected_Site_Atomic]
RESIDENT Temp_Bg_Sites_Mapped
WHERE Len(Trim(SubField(Mapped_Site, ','))) > 1 
  AND Trim(SubField(Mapped_Site, ',')) <> 'DELETE';

DROP TABLES Temp_Bg_Sites_Clean, Temp_Bg_Sites_Split, Temp_Bg_Sites_Mapped;
// ===========================================================================
// --- 5. DOMAIN & PROGRAMME LINES ---
// ===========================================================================

Bridge_Project_Domain_BMS:
LOAD DISTINCT
    [Project ID],
    // 1. Standardizing: Keeping only the short code before the dash (e.g. "SU - SUPPORT" becomes "SU")
    Trim(SubField(Clean_Domain_Element, '-', 1)) AS [Process_Domain_Final_A]
;
LOAD DISTINCT
    [Project ID],
    // 2. Splitting by comma
    Trim(SubField(Comma_Domain_String, ',')) AS Clean_Domain_Element
;
LOAD DISTINCT
    [Project ID],
   // 3. Turning all messy separators into commas
    Replace(Replace(Replace(Replace(Replace(Raw_Domain_String, Chr(10), ','), Chr(13), ','), '/', ','), ';', ','), '&', ',') AS Comma_Domain_String
;
LOAD DISTINCT
    [Project ID],
  
    Upper(Trim(
        If(Len(Trim([Process_Domain_Cor])) > 0, [Process_Domain_Cor], [Background_BMS_L0])
    )) AS Raw_Domain_String
RESIDENT Projects
WHERE [Project ID] <> '-' 
  AND NOT Match(Upper(Trim(If(Len(Trim([Process_Domain_Cor])) > 0, [Process_Domain_Cor], [Background_BMS_L0]))), '-', 'N/A', '/N/A', 'NONE', 'NULL', 'NA', '0')
  AND Len(Trim(If(Len(Trim([Process_Domain_Cor])) > 0, [Process_Domain_Cor], [Background_BMS_L0]))) > 0;

Bridge_Project_Programme_Line:
LOAD DISTINCT 
    [Project ID],
    [Programme_Line_Final] AS [Programme_Line_Atomic]
RESIDENT Projects
WHERE Len(Trim([Programme_Line_Final])) > 0;

// ===========================================================================
// --- 6. CLEANING AUDIT CLIENTS ---
// =============================================================================

CONCATENATE (Bridge_Client_Master) 
LOAD DISTINCT 
    [Project ID],
    Upper(Trim([Raw_Client_Split])) AS [Audit_Client_Atomic]

// We delete anything that looks like a department code so we only keep real client names.
WHERE Len(Trim([Raw_Client_Split])) > 2 
  AND NOT WildMatch(Upper([Raw_Client_Split]), '*T1Q*', '*TOQ*', '*MRO*', '*SYSTEM*', '*PROGRAM*', '*AIR POWER*', '*DEFENCE*', '*MANAGER*', '*AUDIT*');

LOAD DISTINCT
    [Project ID],
Trim(SubField(Replace(Replace(Replace(Replace(Replace(Replace([Audit_Client_Clean], Chr(10), '|'), Chr(13), '|'), ';', '|'), '/', '|'), '&', '|'), ' AND ', '|'), '|')) AS [Raw_Client_Split]
RESIDENT Projects
WHERE Len(Trim([Audit_Client_Clean])) > 0 AND [Project ID] <> '-';

// ===========================================================================
// --- 7. GLOBAL COUNTRY BRIDGE (WHITELISTING APPROACH) ---
// ===========================================================================

Temp_Country_Raw_Split:
LOAD DISTINCT 
    [Project ID], 
    
    // We separate each data
    Trim(SubField(
        Replace(Replace(Replace(Replace(Replace(Replace(Replace(Replace(
            Upper(Trim(If(Len(Trim([Country_Cor])) > 0, [Country_Cor], [Background_Home_Country])))
        , Chr(10), ','), Chr(13), ','), '/', ','), ';', ','), ' AND ', ','), '&', ','), '|', ','), ':', ',')
    , ',')) AS Potential_Country
    
RESIDENT Projects
WHERE Len(Trim(If(Len(Trim([Country_Cor])) > 0, [Country_Cor], [Background_Home_Country]))) > 0
  AND [Project ID] <> '-';


//  WhiteListing
CONCATENATE (Bridge_Project_Country)
LOAD DISTINCT
    [Project ID],
    
    // 4. We translate into Siglum
    ApplyMap('Map_Country_Label', Validated_ISO) AS [Country_Label],
    
    // 5. We keep country siglum for the map chart
    Validated_ISO AS [Country_Final]
;
LOAD DISTINCT
    [Project ID],
    ApplyMap('Map_Country_ISO', Potential_Country, 'REJECT') AS Validated_ISO
RESIDENT Temp_Country_Raw_Split
WHERE Len(Trim(Potential_Country)) > 0
  AND ApplyMap('Map_Country_ISO', Potential_Country, 'REJECT') <> 'REJECT'; 

DROP TABLE Temp_Country_Raw_Split;
/* ===========================================================================
   SECTION 15: HISTORICAL MERGE & GLOBAL ENGINES
   Goal: We bring the historical records (2016-2023) into our main tables. 
   Then, we run powerful "Engines" to split multiple names, sites, or 
   product lines into separate pieces so users can click and filter them easily.
   =========================================================================== */

// ===========================================================================
// --- 1. MERGING HISTORICAL DATA (Bringing the past into the present) ---
// =========================================================================== 

// ---> A. Merging Historical Sites
// If the main "Sites" table exists, we add the historical sites to it.

IF Not IsNull(TableNumber('Bridge_Project_Sites')) THEN
    CONCATENATE (Bridge_Project_Sites)
    LOAD * RESIDENT Hist_Bridge_Sites;
    DROP Table Hist_Bridge_Sites;
ELSE
    RENAME TABLE Hist_Bridge_Sites TO Bridge_Project_Sites;
END IF;

// ---> B. Merging Historical Departments (BMS)
IF Not IsNull(TableNumber('Bridge_Project_Domain_BMS')) THEN
    CONCATENATE (Bridge_Project_Domain_BMS)
    LOAD DISTINCT [Project ID], 
    Trim(SubField([BMS_L0_Atomic], '-', 1)) AS [Process_Domain_Final_A]
    RESIDENT Hist_Projects 
    WHERE Len(Trim([BMS_L0_Atomic]))>0 AND [BMS_L0_Atomic] <> '-';
ELSE
    Bridge_Project_Domain_BMS:
    LOAD DISTINCT [Project ID], 
    Trim(SubField([BMS_L0_Atomic], '-', 1)) AS [Process_Domain_Final_A]
    RESIDENT Hist_Projects 
    WHERE Len(Trim([BMS_L0_Atomic]))>0 AND [BMS_L0_Atomic] <> '-';
END IF;
DROP Fields [BMS_L0_Atomic] FROM Hist_Projects;

// ---> C. Merging Core Tables (Projects, Findings, Actions)
CONCATENATE (Projects)
LOAD * RESIDENT Hist_Projects;
DROP Table Hist_Projects;

CONCATENATE (Findings)
LOAD * RESIDENT Hist_Findings;
DROP Table Hist_Findings;

CONCATENATE (Actions)
LOAD * RESIDENT Hist_Actions;
DROP Table Hist_Actions;

/* ===========================================================================
   --- 2. CREATING "FLAT" COLUMNS FOR SITES AND COUNTRIES ---
   We group the split items back together with a slash ("FR / UK") 
   so they look nice when displayed in a table.
   =========================================================================== */

// Flat column for Sites
LEFT JOIN (Projects)
LOAD [Project ID],
Concat(DISTINCT [Affected_Site_Atomic], ' / ') AS [Affected_Site_Flat]
RESIDENT Bridge_Project_Sites
GROUP BY [Project ID];

// Flat column for Countries
LEFT JOIN (Projects)
LOAD [Project ID],
Concat(DISTINCT [Country_Label], ' / ') AS [Country_Flat]
RESIDENT Bridge_Project_Country
GROUP BY [Project ID];

/* ===========================================================================
   --- 3. THE CO-AUDITOR ENGINE (Splitting and Tagging) ---
   Goal: If multiple Co-Auditors are listed, we split them. We also detect 
   if someone is a "Trainee" or "Observer" and add a clean tag to their name.
   =========================================================================== */

// Step A: Splitting the text

Temp_CoAuditors_Split:
LOAD 
    [Project ID],
    Trim(SubField(Replace(Replace(Replace(Replace(Replace(Replace(Replace([Co_Auditor_Final], 
        ' / (', ' ('),       // Répare les rôles séparés par erreur
        '/ (', ' ('),        // Répare les rôles séparés par erreur
        ' / AL', ' (AL'),    // Répare l'erreur AL
        Chr(10), '/'),       // Transforme les sauts de ligne en slash
        Chr(13), '/'), 
        ';', '/'),           // Transforme les points-virgules en slash
        ' and ', '/'),       // Transforme les "and" en slash
    '/')) AS [Raw_Split_Name_Step1]
RESIDENT Projects
WHERE Len(Trim([Co_Auditor_Final])) > 0 AND [Co_Auditor_Final] <> '-';

// Step B: Cleaning HTML and SharePoint garbage
Temp_CoAuditors_Cleaned:
LOAD 
    [Project ID],
    Trim(Replace(Replace(SubField(Replace([Raw_Split_Name_Step1], ';#', '#'), '#', 1), 'strong>', ''), 'span>', '')) AS [Raw_Split_Name]
RESIDENT Temp_CoAuditors_Split
WHERE Len(Trim([Raw_Split_Name_Step1])) > 2 
AND NOT WildMatch(Upper(Trim([Raw_Split_Name_Step1])), '*NONE*', '*N/A*', '*TBA*', 'CF', 'SPS', 'AIP', 'AIR POWER', 'CI', 'PL', 'PROGRAMME LINE*');

// Step C: Adding the Tag and using the Dictionary
Temp_CoAuditors_Mapped:
LOAD 
    [Project ID],
    [Raw_Split_Name],
    If(WildMatch([Raw_Split_Name], '*trainee*', '*training*'), '(Trainee)',
    If(WildMatch([Raw_Split_Name], '*supervisor*'), '(Supervisor)',
    If(WildMatch([Raw_Split_Name], '*external*'), '(External)',
    If(WildMatch([Raw_Split_Name], '*specialist*'), '(Specialist)',
    If(WildMatch([Raw_Split_Name], '*observer*'), '(Observer)', 
    If(WildMatch([Raw_Split_Name], '*co-auditor*', '*co auditor*'), '(Co-Auditor)',
    '')))))) AS [Auditor_Tag],
    
    // Using the dictionary to correct the name, and removing messy roles from the base name
    ApplyMap('Map_Master_CoAuditors', Upper([Raw_Split_Name]), 
        // Fallback : on nettoie les vieux textes pour garder un nom propre
        Capitalize(Trim(Replace(Replace(Replace(Replace(Replace(Replace(Upper([Raw_Split_Name]), 'AS A TRAINEE', ''), 'AS TRAINEE', ''), '(TRAINEE)', ''), '(EXTERNAL)', ''), '(AL AS SUPERVISOR)', ''), '(CO-AUDITOR)', '')))
    ) AS [Mapped_Base_Name]
RESIDENT Temp_CoAuditors_Cleaned;

// Step D: Creating the Filter Table (Atomic)
Bridge_Project_Co_Auditor:
LOAD DISTINCT 
    [Project ID],
    // On recolle le Nom propre + Le Tag standardisé
    Trim([Mapped_Base_Name] & ' ' & [Auditor_Tag]) AS [Co_Auditor_Project_Atomic],
    [Auditor_Tag] AS [Co_Auditor_Context]
RESIDENT Temp_CoAuditors_Mapped
WHERE Len(Trim([Mapped_Base_Name])) > 1; // 🟢 Bloque les lignes vides (Ghost splits) !

// Step E: Creating the Flat column for displays
LEFT JOIN (Projects)
LOAD 
    [Project ID],
    Concat(DISTINCT [Co_Auditor_Project_Atomic], ' / ') AS [Co_Auditor_Flat]
RESIDENT Bridge_Project_Co_Auditor
GROUP BY [Project ID];

DROP TABLES Temp_CoAuditors_Split, Temp_CoAuditors_Cleaned, Temp_CoAuditors_Mapped;


/* ===========================================================================
   --- 4. THE PRODUCT LINES ENGINE ---
   Goal: We split the airplanes (A320, A400M) into individual filterable items.
   =========================================================================== */

// Step 1: Replace line breaks and slashes with commas BEFORE splitting
Temp_ProductLine_PreClean:
LOAD DISTINCT 
    [Project ID],
    Replace(Replace(Replace(Replace([Product_Line_Clean], Chr(10), ','), Chr(13), ','), '/', ','), ';', ',') AS [PreCleaned_PL]
RESIDENT Projects
WHERE Len(Trim([Product_Line_Clean])) > 0 AND [Product_Line_Clean] <> '-';

// Step 2: Split by the comma
Temp_ProductLine_Split:
LOAD 
    [Project ID],
    Upper(Trim(SubField([PreCleaned_PL], ','))) AS [Raw_PL_Split]
RESIDENT Temp_ProductLine_PreClean;

// Step 3: Apply the Dictionary
Bridge_Project_Product_Line:
LOAD DISTINCT
    [Project ID],
    // The raw version (in case we need to see what was originally typed)
    Capitalize([Raw_PL_Split]) AS [Product_Line_Raw_Atomic],
    
   // The clean version translated by the dictionary
    ApplyMap('Map_Master_ProductLine', [Raw_PL_Split], Capitalize([Raw_PL_Split])) AS [Product_Line_Atomic]
RESIDENT Temp_ProductLine_Split
WHERE Len(Trim([Raw_PL_Split])) > 1; // Bouclier anti-vides

// Step 4: Creating the Flat column for displays
LEFT JOIN (Projects)
LOAD 
    [Project ID],
    Concat(DISTINCT [Product_Line_Atomic], ' / ') AS [Product_Line_Flat]
RESIDENT Bridge_Project_Product_Line
GROUP BY [Project ID];
DROP TABLES Temp_ProductLine_PreClean, Temp_ProductLine_Split;


/* ===========================================================================
   --- 5. AFFECTED SITES  ---
   =========================================================================== */

// Step 1: Save the original text
Temp_Sites_Raw:
LOAD DISTINCT [Project ID], Trim([Affected_Site_Raw]) AS [Affected_Site_Original_Source]
RESIDENT Projects
WHERE Len(Trim([Affected_Site_Raw])) > 0 AND [Affected_Site_Raw] <> '-';

// Step 2: Extreme Cleaning - Destroys invisible spaces, protects dashes, turns punctuation to commas
Temp_Sites_Clean:
LOAD 
    [Project ID],
    Upper(Trim(Replace(Replace(Replace(Replace(Replace(Replace(Replace(Replace(Replace(Replace(Replace(Replace(Replace(Replace(Replace(Replace(Replace([Affected_Site_Original_Source], Chr(160), ' '), '   ', ' '), '  ', ' '), Chr(10), ','), Chr(13), ','), '\n', ','), '\r', ','), '(', ','), ')', ','), ':', ','), ' - ', ','), ';', ','), '/', ','), '|', ','), '&', ','), '+', ','), ' AND ', ','))) AS Raw_Site_Prepared
RESIDENT Temp_Sites_Raw;

// Step 3: Cutting 
NoConcatenate
Temp_Sites_Split:
LOAD DISTINCT 
    [Project ID],
    Trim(SubField(Raw_Site_Prepared, ',')) AS Raw_Site_Atomic
RESIDENT Temp_Sites_Clean;

// Step 4: Apply the Dictionary
NoConcatenate
Temp_Sites_Mapped:
LOAD DISTINCT
    [Project ID],
    ApplyMap('Map_Master_Sites', Upper(Trim(Raw_Site_Atomic)), Upper(Trim(Raw_Site_Atomic))) AS Mapped_Site
RESIDENT Temp_Sites_Split
WHERE Len(Trim(Raw_Site_Atomic)) > 1;

// Step 5: Cutting 2 & second CLEAN (Upper, Trim, PurgeChar)
CONCATENATE (Bridge_Project_Sites)
LOAD DISTINCT 
    [Project ID],
    Upper(Trim(PurgeChar(SubField(Mapped_Site, ','), Chr(160)&Chr(9)&Chr(10)&Chr(13)))) AS [Affected_Site_Atomic]
RESIDENT Temp_Sites_Mapped
WHERE Len(Trim(SubField(Mapped_Site, ','))) > 1 
  AND Trim(SubField(Mapped_Site, ',')) <> 'DELETE';

// 🚨 We apply the map on historical data
NoConcatenate
Final_Bridge_Project_Sites:
LOAD DISTINCT 
    [Project ID],
    //We use the map on the historical data
    ApplyMap('Map_Master_Sites', Upper(Trim([Affected_Site_Atomic])), Upper(Trim([Affected_Site_Atomic]))) AS [Affected_Site_Atomic_Clean]
RESIDENT Bridge_Project_Sites;

DROP TABLE Bridge_Project_Sites;

NoConcatenate
Bridge_Project_Sites:
LOAD DISTINCT 
    [Project ID],
    [Affected_Site_Atomic_Clean] AS [Affected_Site_Atomic]
RESIDENT Final_Bridge_Project_Sites
WHERE [Affected_Site_Atomic_Clean] <> 'DELETE';

DROP TABLE Final_Bridge_Project_Sites;

// Step 6: Create the Flat column for displays
LEFT JOIN (Projects)
LOAD [Project ID], Concat(DISTINCT [Affected_Site_Atomic], ' / ') AS [Affected_Site_Flat]
RESIDENT Bridge_Project_Sites GROUP BY [Project ID];

// Step 7: Bring the original text back into the main table
LEFT JOIN (Projects)
LOAD [Project ID], [Affected_Site_Original_Source]
RESIDENT Temp_Sites_Raw;

DROP TABLES Temp_Sites_Raw, Temp_Sites_Clean, Temp_Sites_Split, Temp_Sites_Mapped;

/* ===========================================================================
   SECTION 16: CREATING FLAT FIELDS FOR DASHBOARD TABLES
   Goal: We combine multiple items (like multiple countries or sites) into a 
   single line of text separated by a slash '/'. This makes the data much 
   easier to display and read in simple tables.
   =========================================================================== */
   
// --- Flat column for Sites ---
LEFT JOIN (Projects)
LOAD 
    [Project ID],
    Concat(DISTINCT [Affected_Site_Atomic], ' / ') AS [Affected_Site_Flat]
RESIDENT Bridge_Project_Sites
GROUP BY [Project ID];

// --- Flat column for Countries ---
LEFT JOIN (Projects)
LOAD 
    [Project ID],
    Concat(DISTINCT [Country_Label], ' / ') AS [Country_Flat]
RESIDENT Bridge_Project_Country
GROUP BY [Project ID];

/* ===========================================================================
   AUDITOR TO-DO LIST (ADMINISTRATIVE TASKS)
   Goal: We automatically generate a "To-Do" list for the Lead Auditors. 
   If they forget to submit a mandatory document on time, the system creates 
   a task to remind them.
   =========================================================================== */
   
To_Do_List:
// --- TASK 1: THE FINAL REPORT ---
// Rule: The final report must be delivered within 21 days after the audit ends.
LOAD 
    [Project ID],
    'Final Report Delivery' AS [Task_Name],
    [Lead_Auditor_Final] AS [Task_Owner],
    Date([SLA_Reference_Date] + 21) AS [Task_Due_Date], 
    Today() - ([SLA_Reference_Date] + 21) AS [Task_Days_Overdue]
RESIDENT Projects
// We only create this task if the report is missing AND the audit is from 2024 or later
WHERE Len(Trim([Final_Report_Date])) = 0 
  AND Len(Trim([SLA_Reference_Date])) > 0
  AND [Audit_Plan_Year] >= 2024; 

// --- TASK 2: THE ENGAGEMENT LETTER ---
// Rule: The engagement letter must be sent 30 days before the audit actually starts.
CONCATENATE (To_Do_List)
LOAD 
    [Project ID],
    'Engagement Letter Delivery' AS [Task_Name],
    [Lead_Auditor_Final] AS [Task_Owner],
    Date([Audit_Planned_Start_Date] - 30) AS [Task_Due_Date], // 🟢 LA CORRECTION EST ICI AUSSI
    Today() - ([Audit_Planned_Start_Date] - 30) AS [Task_Days_Overdue]
RESIDENT Projects
WHERE Len(Trim([Engagement_Letter_Date])) = 0 
  AND Len(Trim([Audit_Planned_Start_Date])) > 0;
