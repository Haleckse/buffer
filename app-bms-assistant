/**
 * Récupère le texte de tous les fichiers Google Docs ou texte brut dans un dossier Drive donné.
 * Remplacez FOLDER_ID par l'identifiant de votre dossier (la partie après /folders/ dans l'URL).
 */
function getDriveFolderContext(folderId, userQuery) {
  if (!folderId) {
    return { error: "ID de dossier Drive manquant." };
  }

  try {
    const folder = DriveApp.getFolderById(folderId);
    const files = folder.getFiles();
    let aggregatedChunks = [];

    const queryKeywords = userQuery
      .toLowerCase()
      .split(/\s+/)
      .filter(w => w.length > 3);

    while (files.hasNext()) {
      const file = files.next();
      const mime = file.getMimeType();
      let text = "";

      if (mime === MimeType.GOOGLE_DOCS) {
        text = DocumentApp.openById(file.getId()).getBody().getText();
      } else if (mime === MimeType.PLAIN_TEXT) {
        text = file.getBlob().getDataAsString();
      }

      if (text.length > 0) {
        // Découpage en blocs de ~500 caractères
        const chunks = text.match(/.{1,500}/gs) || [text];
        
        chunks.forEach((chunk) => {
          let score = 0;
          const lowerChunk = chunk.toLowerCase();
          queryKeywords.forEach(kw => {
            if (lowerChunk.includes(kw)) score++;
          });

          aggregatedChunks.push({
            source: file.getName(),
            text: chunk,
            score: score
          });
        });
      }
    }

    // Trie par pertinence et retient les 4 meilleurs blocs
    aggregatedChunks.sort((a, b) => b.score - a.score);
    const topChunks = aggregatedChunks.slice(0, 4);

    if (topChunks.length === 0 || topChunks[0].score === 0) {
      // Si aucun mot-clé direct ne matche, on extrait un extrait global
      const fallback = aggregatedChunks.slice(0, 2).map(c => `\n${c.text}`).join("\n\n");
      return { context: fallback || "Aucun contenu pertinent trouvé." };
    }

    const contextText = topChunks.map(c => `\n${c.text}`).join("\n\n");
    return { context: contextText };

  } catch (err) {
    return { error: "Erreur lors de la lecture du dossier Drive : " + err.message };
  }
}







<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <title>DAISEI Workspace Chat</title>
  <style>
    body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; margin: 0; display: flex; height: 100vh; background-color: #f8f9fa; }
